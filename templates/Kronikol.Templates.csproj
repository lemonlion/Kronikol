<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Kronikol.Templates</PackageId>
    <Title>Kronikol Project Templates</Title>
    <Authors>Aryeh Citron</Authors>
    <Description>dotnet new templates for creating test projects pre-configured with Kronikol dependency tracking and report generation. Supports xUnit v3, xUnit v2, TUnit, NUnit 4, MSTest, LightBDD, BDDfy, and ReqNRoll.</Description>
    <PackageTags>dotnet-new;templates;testing;diagrams;bdd;plantuml;sequence-diagram;xunit;nunit;mstest;tunit;lightbdd;reqnroll;bddfy</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/lemonlion/Kronikol</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lemonlion/Kronikol</RepositoryUrl>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="kronikol-xunit3\**\*" Exclude="kronikol-xunit3\**\bin\**;kronikol-xunit3\**\obj\**" />
    <Content Include="kronikol-xunit2\**\*" Exclude="kronikol-xunit2\**\bin\**;kronikol-xunit2\**\obj\**" />
    <Content Include="kronikol-tunit\**\*" Exclude="kronikol-tunit\**\bin\**;kronikol-tunit\**\obj\**" />
    <Content Include="kronikol-nunit4\**\*" Exclude="kronikol-nunit4\**\bin\**;kronikol-nunit4\**\obj\**" />
    <Content Include="kronikol-mstest\**\*" Exclude="kronikol-mstest\**\bin\**;kronikol-mstest\**\obj\**" />
    <Content Include="kronikol-lightbdd-xunit3\**\*" Exclude="kronikol-lightbdd-xunit3\**\bin\**;kronikol-lightbdd-xunit3\**\obj\**" />
    <Content Include="kronikol-lightbdd-xunit2\**\*" Exclude="kronikol-lightbdd-xunit2\**\bin\**;kronikol-lightbdd-xunit2\**\obj\**" />
    <Content Include="kronikol-lightbdd-tunit\**\*" Exclude="kronikol-lightbdd-tunit\**\bin\**;kronikol-lightbdd-tunit\**\obj\**" />
    <Content Include="kronikol-bddfy-xunit3\**\*" Exclude="kronikol-bddfy-xunit3\**\bin\**;kronikol-bddfy-xunit3\**\obj\**" />
    <Content Include="kronikol-reqnroll-xunit3\**\*" Exclude="kronikol-reqnroll-xunit3\**\bin\**;kronikol-reqnroll-xunit3\**\obj\**" />
    <Content Include="kronikol-reqnroll-xunit2\**\*" Exclude="kronikol-reqnroll-xunit2\**\bin\**;kronikol-reqnroll-xunit2\**\obj\**" />
    <Content Include="kronikol-reqnroll-tunit\**\*" Exclude="kronikol-reqnroll-tunit\**\bin\**;kronikol-reqnroll-tunit\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <!-- Every template ships the agent skill and the CLAUDE.md/AGENTS.md block, from ONE copy on disk.
       `templates/skills/` and `templates/agents/CLAUDE.md` are canonical (plan section 9 Q6); the repo's own
       `.claude/skills/` copy, `kronikol init-agents` and these twelve templates all install those same
       bytes, and SkillDriftTests pins every copy to them. Packing by PackagePath rather than copying the
       files into twelve folders keeps that one copy honest - 36 physical duplicates would drift.
       AGENTS.md exists only as a package path: `.gitignore` ignores that file name at every depth, so a
       real `templates/*/AGENTS.md` would build here and be silently missing from CI's checkout.
       NoDefaultExcludes above is what lets the dot-directory survive `dotnet pack`; do not remove it. -->
  <ItemGroup>
    <KronikolTemplateRoot Include="kronikol-xunit3;kronikol-xunit2;kronikol-tunit;kronikol-nunit4;kronikol-mstest;kronikol-lightbdd-xunit3;kronikol-lightbdd-xunit2;kronikol-lightbdd-tunit;kronikol-bddfy-xunit3;kronikol-reqnroll-xunit3;kronikol-reqnroll-xunit2;kronikol-reqnroll-tunit" />
    <KronikolSkillFile Include="skills\kronikol-test-debugging\**\*" />
  </ItemGroup>

  <Target Name="_PackKronikolAgentFilesIntoEveryTemplate" BeforeTargets="_GetPackageFiles" Outputs="%(KronikolTemplateRoot.Identity)">
    <PropertyGroup>
      <_KronikolTemplateRoot>%(KronikolTemplateRoot.Identity)</_KronikolTemplateRoot>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="@(KronikolSkillFile)" PackagePath="content\$(_KronikolTemplateRoot)\.claude\skills\kronikol-test-debugging\%(RecursiveDir)%(Filename)%(Extension)" />
      <Content Include="agents\CLAUDE.md" PackagePath="content\$(_KronikolTemplateRoot)\CLAUDE.md" />
      <Content Include="agents\CLAUDE.md" PackagePath="content\$(_KronikolTemplateRoot)\AGENTS.md" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
