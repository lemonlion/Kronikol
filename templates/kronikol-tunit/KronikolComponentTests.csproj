<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>KronikolComponentTests</RootNamespace>
  </PropertyGroup>

  <!-- Microsoft.AspNetCore.Mvc.Testing ships a major version per .NET version, each for its own target framework only:
       the one matching the framework the project was created for (the template's Framework option). -->
  <PropertyGroup>
    <MvcTestingVersion>10.0.7</MvcTestingVersion>
    <MvcTestingVersion Condition="$(TargetFramework.StartsWith('net9'))">9.0.20</MvcTestingVersion>
    <MvcTestingVersion Condition="$(TargetFramework.StartsWith('net8'))">8.0.31</MvcTestingVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.componenttests.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MvcTestingVersion)" />
    <PackageReference Include="Kronikol.TUnit" Version="4.20.4" />
    <PackageReference Include="TUnit" Version="1.53.0" />
  </ItemGroup>

  <!-- TODO: Add a ProjectReference to your API project here -->
  <!-- <ProjectReference Include="..\YourApi\YourApi.csproj" /> -->

</Project>
