<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The suite runs on the newest 9.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (9.0.0). -->
    <PackageReference Include="MassTransit" Version="9.*" Condition="'$(FloorRun)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.MassTransit\Kronikol.Extensions.MassTransit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\Tracking\RequestHeaderAccessor.cs" Link="RequestHeaderAccessor.cs" />
    <Compile Include="..\Kronikol.Tests\History\HistoryGuard.cs" Link="HistoryGuard.cs" />
    <Compile Include="..\Kronikol.Tests\CallGraph\TrackedMessages.cs" Link="TrackedMessages.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\PackedNuspec.cs" Link="PackedNuspec.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\FloorLedger.cs" Link="FloorLedger.cs" />
  </ItemGroup>

</Project>
