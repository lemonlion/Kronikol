<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;NU1902;NU1903;NU1904</NoWarn>
    <!-- MongoDB.Driver asks for the MongoDB.Bson of its own release, so with -p:FloorRun=true the suite takes the driver
         at the Bson floor the package asks for, or at the release a floor search probes (-p:MongoBsonFloor=<release>),
         and otherwise at 2.30.0 (plans/CLIENT_FLOORS_PLAN.md R2c). -->
    <MongoBsonFloor Condition="'$(MongoBsonFloor)' == ''">2.28.0</MongoBsonFloor>
    <MongoDriver>2.30.0</MongoDriver>
    <MongoDriver Condition="'$(FloorRun)' == 'true'">$(MongoBsonFloor)</MongoDriver>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real clients the taps are proven against, pinned to the versions a tapped .NET service of this
         generation actually uses: StackExchange.Redis 2.6.x (RESP2 by default) and MongoDB.Driver 2.30.x. Redis at
         2.6.80, the floor the Redis extension this project references asks for (plans/CLIENT_FLOORS_PLAN.md F27). -->
    <PackageReference Include="StackExchange.Redis" Version="2.6.80" />
    <PackageReference Include="MongoDB.Driver" Version="$(MongoDriver)" />
    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.16.0" />
    <!-- The suite runs on the newest 2.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (2.28.0). -->
    <PackageReference Include="MongoDB.Bson" Version="2.*" Condition="'$(FloorRun)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="MongoWireShapes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MongoTapNotes.golden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\CultureRun.cs" Link="CultureRun.cs" />
    <!-- Ports for the listeners the facts start, never one twice in this process (LoopbackPort.cs says why). -->
    <Compile Include="..\Kronikol.Tests\LoopbackPort.cs" Link="LoopbackPort.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol\Kronikol.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.TcpTap\Kronikol.Extensions.TcpTap.csproj" />
    <!-- The in-process extensions the golden label tests compare against. The MongoDB extension is referenced
         through its driver-2.x build so the whole test assembly stays on one MongoDB.Bson version. -->
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Redis\Kronikol.Extensions.Redis.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.MongoDB.V2\Kronikol.Extensions.MongoDB.V2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\History\HistoryGuard.cs" Link="HistoryGuard.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\PackedNuspec.cs" Link="PackedNuspec.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\FloorLedger.cs" Link="FloorLedger.cs" />
  </ItemGroup>

</Project>
