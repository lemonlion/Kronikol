<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <!-- All three supported ClickHouse ADO.NET clients, to verify each is tracked -->
    <!-- The suite runs on the newest 7.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (7.7.0). -->
    <PackageReference Include="ClickHouse.Client" Version="7.*" Condition="'$(FloorRun)' != 'true'" />
    <!-- The suite runs on the newest 1.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (1.3.0). -->
    <PackageReference Include="ClickHouse.Driver" Version="1.*" Condition="'$(FloorRun)' != 'true'" />
    <!-- The suite runs on the newest 3.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (3.1.1). -->
    <PackageReference Include="Octonica.ClickHouseClient" Version="3.*" Condition="'$(FloorRun)' != 'true'" />
    <!-- A real server for the client facts no fake can stand in for (ClickHouseServerFixture) -->
    <PackageReference Include="Testcontainers.ClickHouse" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.ClickHouse\Kronikol.Extensions.ClickHouse.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.ClickHouse.Client\Kronikol.Extensions.ClickHouse.Client.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.ClickHouse.Driver\Kronikol.Extensions.ClickHouse.Driver.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.ClickHouse.Octonica\Kronikol.Extensions.ClickHouse.Octonica.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\History\HistoryGuard.cs" Link="HistoryGuard.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\PackedNuspec.cs" Link="PackedNuspec.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\FloorLedger.cs" Link="FloorLedger.cs" />
  </ItemGroup>

</Project>
