<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The runtime this suite's reporter runs (.NET 8) and the newest: tier-up (F2) depends on the runtime. -->
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- These facts build hundreds of clients: with quick JIT on, the runtime recompiles the patched Build() after a few
         dozen and drops the patch (F2). This is the remedy the interceptor names. -->
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <!-- With quick JIT off a method is compiled optimized at its first call, and the JIT can then inline Build() into a
         method compiled before the patch, whose builds stay untracked. A Debug build compiles nothing optimized and so
         hides that: every configuration compiles these facts as CI's Release run does. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Kafka.BuildInterception\Kronikol.Extensions.Kafka.BuildInterception.csproj" />
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Kafka\Kronikol.Extensions.Kafka.csproj" />
  </ItemGroup>
</Project>
