<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- A real MongoDB for the host lane (MongoDbHostAttributionTests), as Kronikol.Tests.TcpTap starts one. -->
    <PackageReference Include="Testcontainers.MongoDb" Version="4.8.1" />
    <!-- The suite runs on the newest 3.x, which most consumers have; the extension compiles against its floor (3.9.0),
         so it cannot call anything newer, and Kronikol.Tests.EndToEnd, which takes the extension alone, runs on it. -->
    <PackageReference Include="MongoDB.Driver" Version="3.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="MongoJsonGolden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.MongoDB\Kronikol.Extensions.MongoDB.csproj" />
  </ItemGroup>
</Project>
