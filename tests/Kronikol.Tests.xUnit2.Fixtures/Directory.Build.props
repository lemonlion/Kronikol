<Project>
  <!--
    Test assemblies that fail on purpose, run by Kronikol.Tests.xUnit2's lane facts (Lane/) in a child
    `dotnet test`, which read each run's TRX and the report it wrote. They are never run on their own: CI's
    auto-discovery skips this folder, since no project file sits at its top.

    MSBuild imports the first Directory.Build.props it finds walking up from a project, so this file stops
    the search here and each fixture builds as a consumer's suite would, on net8.0 (the oldest target
    Kronikol.xUnit2 ships) with xunit 2.9.3. src/Kronikol.xUnit2 still builds with the repo's own props.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The VS adapter a lane runs under; a fixture names the other one (T19). -->
    <FixtureRunnerVersion Condition="'$(FixtureRunnerVersion)' == ''">2.8.2</FixtureRunnerVersion>
    <!-- xUnit1004: skipped on purpose. xUnit1045: rows that cannot be serialized, on purpose.
         xUnit1041: a constructor argument nothing provides, on purpose. -->
    <NoWarn>$(NoWarn);xUnit1004;xUnit1045;xUnit1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(FixtureRunnerVersion)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Kronikol.xUnit2\Kronikol.xUnit2.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
