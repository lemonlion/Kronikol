<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- A real MongoDB for the host lane (MongoDbHostAttributionTests), as Kronikol.Tests.TcpTap starts one. -->
    <PackageReference Include="Testcontainers.MongoDb" Version="4.8.1" />
    <!-- The suite runs on the newest 2.x, as a consumer would; the extension compiles against its floor (2.28.0), so it
         cannot call anything newer, and this project compiling against it shows a later 2.x can call it. -->
    <PackageReference Include="MongoDB.Driver" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.MongoDB.V2\Kronikol.Extensions.MongoDB.V2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbTrackingSubscriberTests.cs" Link="MongoDbTrackingSubscriberTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbOperationClassifierTests.cs" Link="MongoDbOperationClassifierTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoClientSettingsExtensionsTests.cs" Link="MongoClientSettingsExtensionsTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbServiceCollectionExtensionsTests.cs" Link="MongoDbServiceCollectionExtensionsTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\ChangeStreamCorrelationTests.cs" Link="ChangeStreamCorrelationTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\HeaderAccessor.cs" Link="HeaderAccessor.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoServerFixture.cs" Link="MongoServerFixture.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbHostAttributionTests.cs" Link="MongoDbHostAttributionTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoJsonTests.cs" Link="MongoJsonTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbProcessWideTests.cs" Link="MongoDbProcessWideTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbFailuresDigestTests.cs" Link="MongoDbFailuresDigestTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbPackageTests.cs" Link="MongoDbPackageTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbRealServerTests.cs" Link="MongoDbRealServerTests.cs" />
    <Compile Include="..\Kronikol.Tests.MongoDB\MongoDbQueryTests.cs" Link="MongoDbQueryTests.cs" />
    <None Include="..\Kronikol.Tests.MongoDB\MongoJsonGolden.txt" Link="MongoJsonGolden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\History\HistoryGuard.cs" Link="HistoryGuard.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\PackedNuspec.cs" Link="PackedNuspec.cs" />
  </ItemGroup>

</Project>
