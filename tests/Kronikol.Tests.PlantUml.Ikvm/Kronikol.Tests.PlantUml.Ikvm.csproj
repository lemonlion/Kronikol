      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The suite runs on the newest 8.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (8.9.0). -->
