<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The server release of the extension's Grpc.Net.Client floor, for the floor run. -->
    <GrpcServerFloor Condition="'$(GrpcServerFloor)' == ''">2.45.0</GrpcServerFloor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- A real gRPC server for the multi-host facts (MultiHost/). Grpc.AspNetCore brings a Grpc.Net.Client and a
         Google.Protobuf of its own release, so the suite runs on the newest 2.x; with -p:FloorRun=true the server is
         the release of the extension's client floor, so the suite runs on the floors the package asks for. -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" Condition="'$(FloorRun)' != 'true'" />
    <PackageReference Include="Grpc.AspNetCore" Version="$(GrpcServerFloor)" Condition="'$(FloorRun)' == 'true'" />
    <!-- The suite runs on the newest 2.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (2.45.0). -->
    <PackageReference Include="Grpc.Net.Client" Version="2.*" Condition="'$(FloorRun)' != 'true'" />
    <!-- The suite runs on the newest 3.x; -p:FloorRun=true drops this reference, so it runs on the floor the package
         asks for (3.19.4). -->
    <PackageReference Include="Google.Protobuf" Version="3.*" Condition="'$(FloorRun)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\hop.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Grpc\Kronikol.Extensions.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kronikol.Tests\History\HistoryGuard.cs" Link="HistoryGuard.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\PackedNuspec.cs" Link="PackedNuspec.cs" />
    <Compile Include="..\Kronikol.Tests\Packaging\FloorLedger.cs" Link="FloorLedger.cs" />
  </ItemGroup>

</Project>
