<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\test.runsettings</RunSettingsFilePath>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The OpenTelemetry-under-Jest spike's spans (plans/INGEST_FIDELITY_PLAN.md S0). -->
    <Content Include="..\Kronikol.Tests\TestData\Ingest\otel-jest-v2.spans.jsonl" Link="TestData\otel-jest-v2.spans.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- #105's own run and the playwright-bdd bypass probe (plans/CUCUMBER_BYPASS_PLAN.md T20). -->
    <Content Include="..\Kronikol.Tests\TestData\Cucumber\issue-105-messages.ndjson" Link="TestData\issue-105-messages.ndjson" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Kronikol.Tests\TestData\Cucumber\issue-105-tests.ndjson" Link="TestData\issue-105-tests.ndjson" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Kronikol.Tests\TestData\Cucumber\playwright-bdd-9.2-bypass-messages.ndjson" Link="TestData\playwright-bdd-9.2-bypass-messages.ndjson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronikol\Kronikol.csproj" />
    <!-- The OTLP/JSON reader that kronikol ingest reads span files with (plans/INGEST_FIDELITY_PLAN.md T21). -->
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Otlp\Kronikol.Extensions.Otlp.csproj" />
    <!-- The gRPC interceptor's row of the diagnostic page (plans/GRPC_IDENTITY_PROPAGATION_PLAN.md T36). -->
    <ProjectReference Include="..\..\src\Kronikol.Extensions.Grpc\Kronikol.Extensions.Grpc.csproj" />
  </ItemGroup>

</Project>
