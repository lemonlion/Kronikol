+    private static void CloseStepIfTaskStubThrows(MethodDefinition method, ILProcessor il, Instruction tryStart, List<Instruction> rets,
+        MethodReference completeStepAsync, MethodReference completeStepFailed)
+    {
+        var body = method.Body;
+        var module = method.Module;
+
+        // A tail call hands the frame on, and this frame still has its catch and its end to run.
+        foreach (var prefix in body.Instructions.Where(i => i.OpCode == OpCodes.Tail).ToList())
+        {
+            prefix.OpCode = OpCodes.Nop;
+            prefix.Operand = null;
+        }
+
+        var exceptionType = module.ImportReference(typeof(Exception));
+        var getMessage = module.ImportReference(typeof(Exception).GetProperty(nameof(Exception.Message))!.GetGetMethod()!);
+        var resultLocal = new VariableDefinition(method.ReturnType);
+        var exceptionLocal = new VariableDefinition(exceptionType);
+        body.Variables.Add(resultLocal);
+        body.Variables.Add(exceptionLocal);
+
+        var afterCatch = il.Create(OpCodes.Ldloc, resultLocal);
+        foreach (var ret in rets)
+        {
+            // In place, so a branch to this ret still lands on it.
+            ret.OpCode = OpCodes.Stloc;
+            ret.Operand = resultLocal;
+            il.InsertAfter(ret, il.Create(OpCodes.Leave, afterCatch));
+        }
+
+        var catchStart = il.Create(OpCodes.Stloc, exceptionLocal);
+
+        // Cecil reads a null HandlerEnd as the method's end: a handler the method ended in would swallow all that is appended here.
+        foreach (var inner in body.ExceptionHandlers.Where(h => h.HandlerEnd == null))
+            inner.HandlerEnd = catchStart;
+
+        il.Append(catchStart);
+        if (method.DebugInformation?.HasSequencePoints == true)
+        {
+            var points = method.DebugInformation.SequencePoints;
+            points.Add(new SequencePoint(catchStart, points[0].Document) { StartLine = 0xFEEFEE, EndLine = 0xFEEFEE });
+        }
+
+        il.Append(il.Create(OpCodes.Ldc_I4_0));
+        il.Append(il.Create(OpCodes.Ldloc, exceptionLocal));
+        il.Append(il.Create(OpCodes.Callvirt, getMessage));
+        il.Append(il.Create(OpCodes.Call, completeStepFailed));
+        il.Append(il.Create(OpCodes.Rethrow));
+        il.Append(afterCatch);
+        il.Append(il.Create(OpCodes.Call, completeStepAsync));
+        il.Append(il.Create(OpCodes.Ret));
+
+        body.ExceptionHandlers.Add(new ExceptionHandler(ExceptionHandlerType.Catch)
+        {
+            TryStart = tryStart,
+            TryEnd = catchStart,
+            HandlerStart = catchStart,
+            HandlerEnd = afterCatch,
+            CatchType = exceptionType
+        });
+    }
