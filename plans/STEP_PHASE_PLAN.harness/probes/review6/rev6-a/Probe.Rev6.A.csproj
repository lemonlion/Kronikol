<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <WeaverVersion Condition="'$(WeaverVersion)' == ''">$(KronikolVersion)</WeaverVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol.xUnit3" Version="$(KronikolVersion)" />
    <PackageReference Include="Kronikol.StepTracking" Version="$(WeaverVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\*.cs" />
  </ItemGroup>
</Project>
