<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS4014;xUnit1041;CA2024;CS0618;xUnit1051;CS1998;NU1603;NU1605</NoWarn>
    <KronikolVersion Condition="'$(KronikolVersion)' == ''">5.28.2</KronikolVersion>
    <StepTrackingVersion Condition="'$(StepTrackingVersion)' == ''">$(KronikolVersion)</StepTrackingVersion>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj-$(KronikolVersion)-$(StepTrackingVersion)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin-$(KronikolVersion)-$(StepTrackingVersion)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-*/**;obj-*/**;out*/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
