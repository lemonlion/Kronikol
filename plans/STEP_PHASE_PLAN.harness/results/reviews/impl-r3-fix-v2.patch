+    // The first step collected for a reported step: a later row of its examples, or a retry, shares its id.
+    private static ScenarioStep? OwnStep(BDDfyStepInfo step, (object? Owner, ScenarioStep Step)[] collected)
+    {
+        foreach (var candidate in collected)
+            if (candidate.Owner is not null && Equals(candidate.Owner, step.StepId))
+                return candidate.Step;
+        return null;
+    }
