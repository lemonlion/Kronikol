+    private static FileAttachment[]? ScenarioAttachments(BDDfyScenarioInfo info)
+    {
+        var scenario = StepCollector.GetScenarioAttachments(info.TestId) ?? [];
+        var collected = StepCollector.GetOwnedSteps(info.TestId);
+        var shown = info.Steps.Select(s => OwnStep(s, collected)).Where(s => s is not null).ToHashSet();
+        FileAttachment[] all = [.. scenario, .. collected.Where(c => !shown.Contains(c.Step)).SelectMany(c => c.Step.Attachments ?? [])];
