@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-295a8250-5b1d-4b46-ac73-e2f29ba8bf28 GET: /milk]]
note left
<color:#686868>[traceparent=00-2a3d1376495b63a1a0fe2e6b83d1d30e-d34b4221bf21666b-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-b5c10550-8924-4a61-8b0a-2a847a373cb8 GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 09:00:43 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-148d2b9d-fcf4-40ef-a05a-e15fe00b4757 GET: /eggs]]
note left
<color:#686868>[traceparent=00-b1eba1be11dcc2417701b9fa8fe477e6-27b67d95deac0472-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-d54005cb-4a78-4c5c-a60b-10a312e3dd2b GET: /flour]]
note left
<color:#686868>[traceparent=00-789039fc6f6540e71e3f765c95da0c85-a8451defeab35818-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-e4145a5a-c183-4068-98e4-5647a91011d3 POST: /cake]]
note left
<color:#686868>[traceparent=00-fe1e6766dca2950698acbf649521dc01-663921deec5db7bc-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-68eea952-145f-4dec-993d-1e1e5d79a2b5 Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "b2bd9ee9-b0ae-493a-8975-6d7115d0cf2f",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "b2bd9ee9-b0ae-493a-8975-6d7115d0cf2f",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the response should be successful

@enduml
