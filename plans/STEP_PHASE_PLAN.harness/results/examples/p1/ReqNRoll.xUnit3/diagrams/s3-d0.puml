@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-da47c772-80ae-4859-b449-09ee4ff45812 GET: /milk]]
note left
<color:#686868>[traceparent=00-0a7c914a0fd197ec795f6b317d008712-c5bc72a650b3bb2c-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-5d4292d5-eb93-47a5-8fbc-4d60ac53b29a GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 08:59:19 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-a7faf8d3-0b3c-49d2-986b-8c3bbf8d7b28 GET: /eggs]]
note left
<color:#686868>[traceparent=00-bc095d2bb8168b69adad4f88ccde7817-d220ecd302f90b11-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-ff74e4e2-b6a7-4b69-a660-61ec2964cadb GET: /flour]]
note left
<color:#686868>[traceparent=00-715f90c7029938c975b9f37130f3af2f-1abd34f62347bed5-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-85a47cba-3a7d-4c9d-962f-14f66c0d18bd POST: /cake]]
note left
<color:#686868>[traceparent=00-d30750c49c76ac0578bcc03dda83499f-f53712bac0dba042-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-f54f257c-8244-41a5-9fa6-9d3ff1769748 Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "a130ec99-39fa-4136-9e18-b7a403456df3",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "a130ec99-39fa-4136-9e18-b7a403456df3",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the cake should contain the requested milk

@enduml
