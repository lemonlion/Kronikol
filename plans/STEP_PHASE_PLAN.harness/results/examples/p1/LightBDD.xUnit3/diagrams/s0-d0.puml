@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>GIVEN A valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-8966b100-81c1-4eba-aea3-2b38e5fb9c44 GET: /milk]]
note left
<color:#686868>[traceparent=00-0f55f3938c1ec29211a998be17484b31-86d813540078c253-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-899a6243-9977-4249-a38a-e9f11b8ac5f5 GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 09:00:20 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-24d50033-a030-4da7-b5dd-e7cd03850348 GET: /eggs]]
note left
<color:#686868>[traceparent=00-4df339e2d1db8d5de987d4fd274a6e94-b4bca53c273b5a60-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-bc8fc12c-50b3-4681-b82e-9860b7aba64c GET: /flour]]
note left
<color:#686868>[traceparent=00-2e006adf1e7d260f1dffe34c6b51af28-5fb6cd77c1cc992f-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>WHEN The request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-53b70a39-b1fa-4598-ab98-b25d2fbc7c22 POST: /cake]]
note left
<color:#686868>[traceparent=00-3a6beb6318b44a3e243f5cc562a4b7c3-5c7ea5a85604fc02-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-2020bcca-8920-41e8-bf36-c5d01d05eb4d Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "7e59c2cb-5064-4308-b2c6-9f5bf4cfb0d6",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "7e59c2cb-5064-4308-b2c6-9f5bf4cfb0d6",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>THEN The response should be successful

@enduml
