@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-de46b243-fd52-4ee7-8f80-f59aa0af4fb6 GET: /milk]]
note left
<color:#686868>[traceparent=00-2f867866908a65eb115a4c3f8a778e1a-044579a053ae74dc-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-6fe2d7c8-7f58-4297-b7ae-e628d4f80c7b GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 12:40:19 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-23e177f4-c253-4e3d-a2b0-707f97b4ed0c GET: /eggs]]
note left
<color:#686868>[traceparent=00-7ef3d742fcde9fcd0c7fd9f992f1d2c7-3bcd727295da2fd3-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-0a7a6c6a-18f3-46ec-ae8d-08027f902733 GET: /flour]]
note left
<color:#686868>[traceparent=00-1154a94bd386a3dc0abfd4debd0246bb-e0c67880af0bba3e-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-6c87fdb1-ce16-4d34-8f2f-8fc09cab3c0d POST: /cake]]
note left
<color:#686868>[traceparent=00-973b519e31f5cf4994f14426416498fc-287ce06e69499d25-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-01190ee1-418a-4ba0-b087-c5e06faf0095 Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "b6561f56-244b-406a-9dbc-a6630f58a240",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "b6561f56-244b-406a-9dbc-a6630f58a240",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the response should be successful

@enduml
