@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>GIVEN A valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-042951cb-4550-4eef-890d-f51ddd903c82 GET: /milk]]
note left
<color:#686868>[traceparent=00-1f00ad1d352f71077677ae4eb0f1e038-3cc16a1fc93cb529-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-58d45003-2f51-4760-b874-2005ecc7d1f1 GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 12:41:33 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-7f2572b3-acb4-4641-9ddc-63eaaafb5966 GET: /eggs]]
note left
<color:#686868>[traceparent=00-e741894333b76e929310ef96fdd410e9-46d8465e95ae201d-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-97a8dbca-3f9e-401f-b997-691111f350b8 GET: /flour]]
note left
<color:#686868>[traceparent=00-45230cec2e7ffec3fc069cbd412388e7-47a3e63c9039c6a5-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>WHEN The request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-80039a3e-75ce-4a8d-9d69-90a088c73f72 POST: /cake]]
note left
<color:#686868>[traceparent=00-2af157ae47e6c864cdd0e67a38f22cd9-defba9cf8fd379d5-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-6692f4ac-f8b1-4ecb-a03a-018b3e0f3d1b Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "d5bb31e8-ee6b-48f8-948e-98be49429164",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "d5bb31e8-ee6b-48f8-948e-98be49429164",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>THEN The response should be successful

@enduml
