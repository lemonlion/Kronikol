@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-78456397-5201-40a4-986b-14292a1ef118 GET: /milk]]
note left
<color:#686868>[traceparent=00-763efc180285632a1eb04a621396c204-3d7f78a9ff5baa54-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-621390e3-ceef-467e-b549-4527d564b37d GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 12:41:57 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-a0aabe0d-a8ea-48b1-8da4-3698fe26864b GET: /eggs]]
note left
<color:#686868>[traceparent=00-18136ba7eaa7a71d6071ad5ab5abdf52-e2b421cc848f8a38-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-d49698aa-a700-4f13-8f67-234315bed33a GET: /flour]]
note left
<color:#686868>[traceparent=00-cab58c18f9df55f07d3ebe93d7f4f47a-368a083f0476910a-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-3b89492d-8db3-4f29-bd3c-8917de9d644f POST: /cake]]
note left
<color:#686868>[traceparent=00-8c4109c973ea0bf9504767c08410a50c-a4a6ac1cbc96d56c-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-50752ea6-24c6-4be2-9a56-75786da5399e Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "5074e441-f1ef-4997-8559-63202bdcaf4c",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "5074e441-f1ef-4997-8559-63202bdcaf4c",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the response should be successful

@enduml
