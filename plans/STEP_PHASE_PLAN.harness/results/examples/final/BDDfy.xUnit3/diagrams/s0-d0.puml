@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-56b49be3-45ac-49b5-9aa0-54c19cdd5bbe GET: /milk]]
note left
<color:#686868>[traceparent=00-a47824738e9fa448c4c17c6ff6449211-1fd083f2f08e378a-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-0d767ca6-4b7a-4819-9f9e-eb34b4239b3c GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 20:35:22 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-9c19da45-70bc-427b-9cbe-2f3bb62b9ef0 GET: /eggs]]
note left
<color:#686868>[traceparent=00-47547ed37ed833a8b9dddb9e16c6a132-0ddd12bd357c0aac-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-28538433-02e9-4637-b57f-0d14ae6bc42a GET: /flour]]
note left
<color:#686868>[traceparent=00-ab3ce87f956127f5894eb31f4a58a0ad-63a44a8c604524b0-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-dc0cef50-2481-491d-a5f8-6b3f1aaa7362 POST: /cake]]
note left
<color:#686868>[traceparent=00-7ee8cee1cf1a96ccb363e1bf517dbff2-a25b1762712dc054-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-3c2c122f-94fe-499e-a56b-05871ddb2c3c Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "ae5f3d17-9186-4227-869d-99d939e0c025",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "ae5f3d17-9186-4227-869d-99d939e0c025",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the response should be successful

@enduml
