@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-a75664fb-400f-4b46-87f8-f6abca728ffc GET: /milk]]
note left
<color:#686868>[traceparent=00-30141a53e5447c416b7d37a4211e6b7a-af28f132266052b9-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-46b8539d-b7e7-4958-8202-62af59d60007 GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 20:34:22 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-5295e7ea-2c5c-4575-afc6-ab250e298514 GET: /eggs]]
note left
<color:#686868>[traceparent=00-7c4a84a5251e6745277bc7f5a1dd43cf-e68c4f8c35fb8be5-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-99ab8085-d9dc-4394-b4a3-919907fd769d GET: /flour]]
note left
<color:#686868>[traceparent=00-599fa080d2953d9ae3c6e112c2fba43e-b81ca70a142d0575-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-7490381d-b14d-4d70-8e96-51628a295063 POST: /cake]]
note left
<color:#686868>[traceparent=00-6af8fd7ba3678b9b6f894d98584435df-d589998df2dffcfd-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-5367c2f3-81cf-43a6-ba8d-cd9fe7d9f316 Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "8728ff37-7b54-4df1-8237-87c36956882a",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "8728ff37-7b54-4df1-8237-87c36956882a",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the cake should contain the requested milk

@enduml
