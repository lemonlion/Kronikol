@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>

<style>
 .stepBody {
     BackgroundColor black
     FontColor white
     LineColor white
     HorizontalAlignment center
 }
</style>
skinparam wrapWidth 800
autonumber 1

participant "(no interactions)" as noInteractions


hnote across <<stepDelimiter>><<stepBody>>: Given a muffin recipe "Classic" with the following ingredients:\n\n|=<space:8><sup><U+200B></sup>Flour<sub><U+200B></sub><space:8>|=<space:8><sup><U+200B></sup>Apples<sub><U+200B></sub><space:8>|=<space:8><sup><U+200B></sup>Cinnamon<sub><U+200B></sub><space:8>|\n|<space:8><sup><U+200B></sup>Plain Flour<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>Granny Smith<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>Ceylon<sub><U+200B></sub><space:8>|


hnote across <<stepDelimiter>><<stepBody>>: And the following baking:\n\n|=<space:8><sup><U+200B></sup>Temperature<sub><U+200B></sub><space:8>|=<space:8><sup><U+200B></sup>DurationMinutes<sub><U+200B></sub><space:8>|=<space:8><sup><U+200B></sup>PanType<sub><U+200B></sub><space:8>|\n|<space:8><sup><U+200B></sup>180<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>25<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>Standard<sub><U+200B></sub><space:8>|


hnote across <<stepDelimiter>><<stepBody>>: And the following muffin toppings:\n\n|=<space:8><sup><U+200B></sup>Name<sub><U+200B></sub><space:8>|=<space:8><sup><U+200B></sup>Amount<sub><U+200B></sub><space:8>|\n|<space:8><sup><U+200B></sup>Streusel<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>Light<sub><U+200B></sub><space:8>|\n|<space:8><sup><U+200B></sup>Icing Glaze<sub><U+200B></sub><space:8>|<space:8><sup><U+200B></sup>Drizzle<sub><U+200B></sub><space:8>|


hnote across <<stepDelimiter>> #black:<color:white>When the muffins are prepared


hnote across <<stepDelimiter>> #black:<color:white>Then the muffin batch should have 5 ingredients


hnote across <<stepDelimiter>> #black:<color:white>And the muffin response should include 2 toppings


hnote across <<stepDelimiter>> #black:<color:white>And the muffin response should have baking info True

@enduml
