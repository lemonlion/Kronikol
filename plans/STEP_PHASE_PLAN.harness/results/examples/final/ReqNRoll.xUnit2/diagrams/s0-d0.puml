@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
sequenceDiagram { group { RoundCorner 16; LineThickness 1; LineColor #CDD5E0; BackgroundColor #F4F7FB; FontStyle plain } }
sequenceDiagram { groupHeader { LineThickness 1; LineColor #CDD5E0; BackgroundColor #E9EEF6 } }
sequenceDiagram { partition { RoundCorner 16; LineThickness 1; LineColor #D5DBE4 } }
</style>
<style>
 .eventNote {
     BackgroundColor #cfecf7
     FontSize 11
     RoundCorner 10
 }
</style>

skinparam wrapWidth 800
autonumber 1

actor "Caller" as caller
participant "Dessert Provider" as dessertProvider
participant "Cow Service" as cowService
queue "Event broker" as eventBroker

partition #F6F6F6 Setup

hnote across <<stepDelimiter>> #black:<color:white>Given a valid post request for the Cake endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-001b9907-47dd-430b-ab99-467349fe1da4 GET: /milk]]
note left
<color:#686868>[traceparent=00-8005a5a20760703eb952db5038965099-f1ad00d65ebe9ef5-00]
end note
dessertProvider -[#438DD5]> cowService: [[#iflow-7aa68c41-243e-4d97-a9cb-739edf15d24c GET: /milk]]
cowService -[#438DD5]-> dessertProvider: OK
note right
<color:#686868>[Date=Tue, 03 Nov 2026 20:33:53 GMT]
<color:#686868>[Server=Kestrel]
<color:#686868>[Transfer-Encoding=chunked]

{
  "milk": "Some_Fresh_Milk"
}
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "milk": "Some_Fresh_Milk"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-c21a1ca8-dc19-433e-aea2-1b65009d3f2c GET: /eggs]]
note left
<color:#686868>[traceparent=00-24f65a4f1411a48886e3c7a80a29e455-47f8e7e0204d188f-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "eggs": "Some_Eggs"
}
end note
caller -[#438DD5]> dessertProvider: [[#iflow-e19826b7-3647-44e8-8fb9-9088aba6a75e GET: /flour]]
note left
<color:#686868>[traceparent=00-192fb983400628ad19bb6939966ae865-225bce5e52b2daaa-00]
end note
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "flour": "Some_Flour"
}
end note
end

hnote across <<stepDelimiter>> #black:<color:white>When the request is sent to the cake post endpoint

caller -[#438DD5]> dessertProvider: [[#iflow-5fb98d2b-4398-4e1a-93e9-86d09a165a90 POST: /cake]]
note left
<color:#686868>[traceparent=00-8bcee9ef4254e9c5746942f36b7f3f29-f1b08e49f885ad1a-00]

{
  "milk": "Some_Fresh_Milk",
  "flour": "Some_Flour",
  "eggs": "Some_Eggs"
}
end note
dessertProvider -[#9B59B6]> eventBroker: [[#iflow-b419dd95-a01b-4c0d-82e5-8d64933311d1 Send (Event Protocol): /cake_events]]
note<<eventNote>> left
{
  "BatchId": "1ed5e472-b67f-4579-b2eb-ceb2f2a36d8e",
  "Ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note
eventBroker -[#9B59B6]-> dessertProvider: Responded
dessertProvider -[#438DD5]-> caller: OK
note right
{
  "batchId": "1ed5e472-b67f-4579-b2eb-ceb2f2a36d8e",
  "ingredients": [
    "Some_Eggs",
    "Some_Fresh_Milk",
    "Some_Flour"
  ]
}
end note

hnote across <<stepDelimiter>> #black:<color:white>Then the response should be successful

@enduml
