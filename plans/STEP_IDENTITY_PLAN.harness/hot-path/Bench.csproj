<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <KronikolVersion Condition="'$(KronikolVersion)' == ''">5.28.2</KronikolVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol" Version="$(KronikolVersion)" Condition="'$(KronikolProto)' == ''" />
    <ProjectReference Include="$(KronikolProto)/src/Kronikol/Kronikol.csproj" Condition="'$(KronikolProto)' != ''" />
  </ItemGroup>
</Project>
