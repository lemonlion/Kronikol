<Project Sdk="Microsoft.NET.Sdk">
  <!-- Named as an assembly Kronikol's InternalsVisibleTo names, on both builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Kronikol.Tests</AssemblyName>
    <RootNamespace>ReviewHeld</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(KronikolRoot)/src/Kronikol/Kronikol.csproj" />
  </ItemGroup>
</Project>
