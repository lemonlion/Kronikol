<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TrackStepsEnabled>true</TrackStepsEnabled>
    <AssemblyName>bddfyprobe</AssemblyName>
    <NoWarn>$(NoWarn);xUnit1051;CS1998;CS4014;xUnit1031;CS0162;CS0414</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="TestStack.BDDfy" Version="8.0.1.3" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Kronikol.BDDfy.xUnit3" Version="5.28.2" />
    <PackageReference Include="Kronikol.StepTracking" Version="5.28.2" />
  </ItemGroup>
</Project>
