<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Probe for ASSERTION_LABELS_PLAN.md (#210). A console app with no test framework, as the #163 probe
    (ASSERTION_VALUE_SUBSTITUTION_PLAN.harness/probe): Track.TestIdResolver names a test per case, and the assertion
    notes each case drew are read back from RequestResponseLogger.
      Woven210   Shouldly 4.3.0 statements, woven at build time (the issue's stack)
      Fluent210  FluentAssertions 6.12.1 statements, woven
      That210    the same shapes through Track.That, in a type the weave leaves alone
    -p:KronikolVersion=<v>  the published Kronikol packages to weave with (default 5.12.0, the repo at planning time)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS1718;CS0219</NoWarn>
    <KronikolVersion Condition="'$(KronikolVersion)' == ''">5.12.0</KronikolVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol" Version="$(KronikolVersion)" />
    <PackageReference Include="Kronikol.AssertionTracking" Version="$(KronikolVersion)" PrivateAssets="all" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>
</Project>
