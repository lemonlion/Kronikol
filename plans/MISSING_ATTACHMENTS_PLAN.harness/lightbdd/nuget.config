<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Isolated cache: every package comes from nuget.org, never from a locally built copy. -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
