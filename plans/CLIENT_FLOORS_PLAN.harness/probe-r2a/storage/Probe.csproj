<Project Sdk="Microsoft.NET.Sdk">
  <!-- R2a's fourth test for Cloud Storage: the client on the extension's floor, or on the newest 4.x with -p:Newest=true. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kronikol.Extensions.CloudStorage/Kronikol.Extensions.CloudStorage.csproj" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.*" Condition="'$(Newest)' == 'true'" />
  </ItemGroup>
</Project>
