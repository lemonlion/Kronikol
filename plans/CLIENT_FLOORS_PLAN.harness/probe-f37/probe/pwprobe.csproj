<Project Sdk="Microsoft.NET.Sdk">
  <!-- F37: whether a Microsoft.Playwright release's driver starts on Linux (-p:PwVersion=...). Built and run in the .NET 10
       SDK container by ../search.py; it starts the driver and stops it, with no browser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <PwVersion Condition="'$(PwVersion)' == ''">1.12.0</PwVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="$(PwVersion)" />
  </ItemGroup>
</Project>
