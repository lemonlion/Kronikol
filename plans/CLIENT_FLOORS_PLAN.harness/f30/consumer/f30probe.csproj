<Project Sdk="Microsoft.NET.Sdk">
  <!-- A consumer of the published Kronikol.TUnit on a later TUnit.Core than the adapter was built against. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TUnitCore Condition="'$(TUnitCore)' == ''">1.53.0</TUnitCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol.TUnit" Version="5.27.7" />
    <PackageReference Include="TUnit.Core" Version="$(TUnitCore)" />
  </ItemGroup>
</Project>
