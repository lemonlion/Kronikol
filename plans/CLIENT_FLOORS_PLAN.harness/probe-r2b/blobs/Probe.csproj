<Project Sdk="Microsoft.NET.Sdk">
  <!-- R2b's fourth test for BlobStorage: the client on the extension's floor, or on the newest 12.x with -p:Newest=true. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kronikol.Extensions.BlobStorage/Kronikol.Extensions.BlobStorage.csproj" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" Condition="'$(Newest)' == 'true'" />
  </ItemGroup>
</Project>
