<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shape probe of plans/STEP_METHOD_SHAPES_PLAN.md: compiles each method shape, weaves it with this worktree's
       StepWeaver (and AssertionWeaver for the I family), then JIT-checks, IL-verifies and runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1701;NU1603</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- not part of the repo's build: its output stays out of the plan's folder -->
    <BaseOutputPath>$(TEMP)\kronikol-226-probe\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(TEMP)\kronikol-226-probe\obj\</BaseIntermediateOutputPath>
    <UseArtifactsOutput>false</UseArtifactsOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.ILVerification" Version="10.0.14" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Kronikol.StepTracking\Kronikol.StepTracking.csproj" />
    <ProjectReference Include="..\..\..\src\Kronikol.AssertionTracking\Kronikol.AssertionTracking.csproj" />
    <ProjectReference Include="..\..\..\src\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
