+    // carries its request's kind. The oracle is this class's own reading of the operation, not MessageTable: the table leaves
+    // a delivery Unknown, and cannot read a call recorded as its HTTP request or under its transport's address.
+    [Theory]
+    [MemberData(nameof(Calls))]
+    public async Task A_call_is_an_event_exactly_when_it_moves_a_message(SnsOperation operation, SnsTrackingVerbosity verbosity)
+    {
+        var call = await Track(operation, verbosity);
+        if (call is null)
+            return; // at Summarised the handler records no call it cannot name
+
+        var expected = Directions[operation] is "publishes" or "consumes" ? RequestResponseMetaType.Event : RequestResponseMetaType.Default;
+        Assert.Equal(expected, call.MetaType);
+        Assert.Equal(expected, RequestResponseLogger.RequestAndResponseLogs.Last(l =>
+            l.TestId == _testId && l.RequestResponseId == call.RequestResponseId && l.Type == RequestResponseType.Response).MetaType);
+    }
 }
