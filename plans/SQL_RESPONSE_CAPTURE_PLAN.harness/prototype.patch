+using System.Data.Common;
+using System.Runtime.CompilerServices;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Metadata;
+using Microsoft.EntityFrameworkCore.Storage;
+
+namespace Kronikol.Extensions.EfCore.Relational;
+
+/// <summary>
+/// PROTOTYPE for plans/SQL_RESPONSE_CAPTURE_PLAN.md: whether every value a model's queries can read goes through a
+/// method of <see cref="DbDataReader"/> itself. EF Core's shaper casts the reader to the declaring type of a type
+/// mapping's <see cref="RelationalTypeMapping.GetDataReaderMethod()"/>, so a mapping read through
+/// <c>SqlDataReader.GetSqlBytes</c> (SQL Server NetTopologySuite) or <c>OracleDataReader.GetDateTimeOffset</c> fails
+/// on any reader that is not the provider's own.
+/// </summary>
+internal static class ProviderReaderMethods
+{
+    private static readonly ConditionalWeakTable<IModel, StrongBox<bool>> Verdicts = new();
+
+    // Types raw SQL commonly projects that no entity may map (SqlQuery<DateTimeOffset>), asked of the type mapping source.
+    private static readonly Type[] ProbedClrTypes = [typeof(DateTimeOffset), typeof(DateOnly), typeof(TimeOnly), typeof(TimeSpan)];
+
+    internal static bool ModelReadsOnlyThroughDbDataReader(DbContext context)
+    {
+        var model = context.Model;
+        if (Verdicts.TryGetValue(model, out var known)) return known.Value;
+
+        var safe = Compute(context, model);
+        Verdicts.AddOrUpdate(model, new StrongBox<bool>(safe));
+        return safe;
+    }
+
+    private static bool Compute(DbContext context, IModel model)
+    {
+        foreach (var entityType in model.GetEntityTypes())
+        {
+            foreach (var property in entityType.GetProperties())
+                if (!ReadThroughDbDataReader(property.FindRelationalTypeMapping())) return false;
+            foreach (var complex in entityType.GetComplexProperties())
+                if (!ComplexReadsThroughDbDataReader(complex.ComplexType)) return false;
+        }
+
+        var source = context.GetService<IRelationalTypeMappingSource>();
+        foreach (var clrType in ProbedClrTypes)
+            if (!ReadThroughDbDataReader(source.FindMapping(clrType))) return false;
+
+        return true;
+    }
+
+    private static bool ComplexReadsThroughDbDataReader(IComplexType complexType)
+    {
+        foreach (var property in complexType.GetProperties())
+            if (!ReadThroughDbDataReader(property.FindRelationalTypeMapping())) return false;
+        foreach (var nested in complexType.GetComplexProperties())
+            if (!ComplexReadsThroughDbDataReader(nested.ComplexType)) return false;
+        return true;
+    }
+
+    private static bool ReadThroughDbDataReader(RelationalTypeMapping? mapping)
+    {
+        if (mapping is null) return true;
+        var declaring = mapping.GetDataReaderMethod().DeclaringType;
+        return declaring is null || declaring.IsAssignableFrom(typeof(DbDataReader));
+    }
+}
