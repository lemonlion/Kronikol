+    private static bool IsPlainJsonValue(object value) => value switch
+    {
+        string or bool or char or byte or sbyte or short or ushort or int or uint or long or ulong or float or double
+            or decimal or Guid or DateTime or DateTimeOffset or DateOnly or TimeOnly or TimeSpan => true,
