diff --git a/src/Kronikol/Sql/SqlEndpoint.cs b/src/Kronikol/Sql/SqlEndpoint.cs
new file mode 100644
index 00000000..bf318b30
--- /dev/null
+++ b/src/Kronikol/Sql/SqlEndpoint.cs
@@ -0,0 +1,67 @@
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace Kronikol.Sql;
+
+/// <summary>
+/// PROTOTYPE for plans/SQL_RESPONSE_CAPTURE_PLAN.md: the parts of a <c>sql://</c> address drawn for a command, made from
+/// whatever a connection reports as its data source, and an address built from them that never throws.
+/// </summary>
+internal static partial class SqlEndpoint
+{
+    /// <summary>
+    /// A host for the address: <c>host:port</c> for SQL Server's <c>host,port</c>, the first host of Npgsql's list,
+    /// without a <c>tcp:</c>, <c>np:</c> or <c>tcp://</c> prefix, and an instance name joined with a dash
+    /// (<c>(localdb)\MSSQLLocalDB</c> is <c>localdb-MSSQLLocalDB</c>).
+    /// </summary>
+    internal static string Host(string? dataSource)
+    {
+        var text = (dataSource ?? "").Trim();
+        if (text.Length == 0) return "localhost";
+
+        foreach (var prefix in (string[])["tcp://", "tcp:", "np:", "lpc:", "admin:"])
+            if (text.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) text = text[prefix.Length..];
+
+        var comma = text.IndexOf(',');
+        if (comma >= 0)
+        {
+            var after = text[(comma + 1)..].Trim();
+            text = after.Length > 0 && after.All(char.IsAsciiDigit) ? $"{text[..comma]}:{after}" : text[..comma];
+        }
+
+        string? port = null;
+        var portMatch = PortSuffix().Match(text);
+        if (portMatch.Success && !text.StartsWith('['))
+        {
+            port = portMatch.Groups[1].Value;
+            text = text[..portMatch.Index];
+        }
+
+        if (Uri.CheckHostName(text) == UriHostNameType.Unknown)
+        {
+            var host = new StringBuilder();
+            foreach (var part in text.Split('\\', '/'))
+            {
+                var name = part.Trim().Trim('(', ')');
+                if (name is "." or "local") name = "localhost";
+                var clean = Regex.Replace(name, "[^A-Za-z0-9.-]+", "-").Trim('-', '.');
+                if (clean.Length == 0) continue;
+                if (host.Length > 0) host.Append('-');
+                host.Append(clean);
+            }
+            text = host.Length > 0 && Uri.CheckHostName(host.ToString()) != UriHostNameType.Unknown ? host.ToString() : "localhost";
+        }
+
+        return port is null ? text : $"{text}:{port}";
+    }
+
+    /// <summary>A path segment (a database or table name) as written, escaped for the address.</summary>
+    internal static string Segment(string? name) => Uri.EscapeDataString(string.IsNullOrEmpty(name) ? "unknown" : name);
+
+    /// <summary>The address, or <c>{scheme}://localhost</c> if the text still does not parse.</summary>
+    internal static Uri Build(string text, string scheme = "sql") =>
+        Uri.TryCreate(text, UriKind.Absolute, out var uri) ? uri : new Uri($"{scheme}://localhost");
+
+    [GeneratedRegex(@":(\d+)$")]
+    private static partial Regex PortSuffix();
+}
