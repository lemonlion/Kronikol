<Project Sdk="Microsoft.NET.Sdk">
  <!-- The control on the issue's version: XunitV2's own AssemblyInfo, types, T1 and T2, linked, on Kronikol 5.12.0.
       A directory of its own, so its obj/ and bin/ are not XunitV2's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <KronikolVersion Condition="'$(KronikolVersion)' == ''">5.12.0</KronikolVersion>
    <AssertionTrackingVersion Condition="'$(AssertionTrackingVersion)' == ''">$(KronikolVersion)</AssertionTrackingVersion>
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\XunitV2\AssemblyInfo.cs;..\XunitV2\Types.cs;..\XunitV2\T1_IssueSecondTestVerbatim.cs;..\XunitV2\T2_IssueFirstShape.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol.AssertionTracking" Version="$(AssertionTrackingVersion)" PrivateAssets="all" />
    <PackageReference Include="Kronikol.xUnit2" Version="$(KronikolVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
