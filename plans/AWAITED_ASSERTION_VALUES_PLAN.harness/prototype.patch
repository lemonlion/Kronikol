+using Microsoft.CodeAnalysis;
+
+namespace Kronikol.Tests.AssertionTracking;
+
+/// <summary>
+/// #211: an awaited assertion's values are read at the await's merge point, after the await. Each case here suspends
+/// for real (the awaited code yields, or Shouldly's ThrowAsync continues the task), so the code after the await runs
+/// in a later call of MoveNext, where an optimized build's locals start zeroed. A woven build must run as the unwoven
+/// one does, and an optimized build must draw the notes a Debug build draws.
+/// </summary>
+public class AwaitedAssertionResumeTests
+{
+    private const string Cases = """
+        using System;
+        using System.Threading.Tasks;
+        using FluentAssertions;
+        using Kronikol.Tracking;
+        using Shouldly;
+
+        [assembly: TrackAssertions]
+
+        public sealed class Client
+        {
+            public async Task<string> CallAsync(string id)
+            {
+                await Task.Yield();
+                throw new InvalidOperationException("expected " + id);
+            }
+
+            public async Task WaitAsync() => await Task.Yield();
+        }
+
+        public sealed class Request
+        {
+            public string Id { get; init; } = "";
+        }
+
+        public class Cases
+        {
+            private readonly Client _client = new();
+
+            // The issue's own two tests, as filed: the object initializer is what makes the compiler keep the closure
+            // in a local, where a closure with nothing to initialize stays on the stack.
+            public async Task Issue_ThrowAsync_is_the_first_await()
+            {
+                var request = new Request { Id = string.Empty };
+
+                var exception = await Should.ThrowAsync<InvalidOperationException>(
+                    async () => await _client.CallAsync(request.Id)
+                );
+
+                exception.Message.ShouldBe("expected ");
+            }
+
+            public async Task Issue_Unassigned_ThrowAsync_is_the_first_await()
+            {
+                var request = new Request { Id = string.Empty };
+
+                await Should.ThrowAsync<InvalidOperationException>(() => _client.CallAsync(request.Id));
+            }
+
+            public async Task Shouldly_ThrowAsync_assigned_first_await()
+            {
+                var id = "a1";
+                var exception = await Should.ThrowAsync<InvalidOperationException>(async () => await _client.CallAsync(id));
+                exception.Message.ShouldBe("expected a1");
+            }
+
+            public async Task Shouldly_ThrowAsync_unassigned_first_await()
+            {
+                var id = "a1";
+                await Should.ThrowAsync<InvalidOperationException>(() => _client.CallAsync(id));
+            }
+
+            public async Task Shouldly_NotThrowAsync_first_await()
+            {
+                var id = "a1";
+                await Should.NotThrowAsync(async () => { await _client.WaitAsync(); id.Length.ShouldBe(2); });
+            }
+
+            public async Task Shouldly_ThrowAsync_in_a_loop_after_an_await()
+            {
+                await Task.Yield();
+                foreach (var id in new[] { "a", "b" })
+                    await Should.ThrowAsync<InvalidOperationException>(() => _client.CallAsync(id));
+            }
+
+            public async Task Fa_WithMessage_reads_the_closure()
+            {
+                var id = "a1";
+                Func<Task> act = () => _client.CallAsync(id);
+                await act.Should().ThrowAsync<InvalidOperationException>().WithMessage("expected " + id);
+            }
+
+            public async Task Fa_WithMessage_plain_local()
+            {
+                var message = "expected a1";
+                Func<Task> act = () => _client.CallAsync("a1");
+                await act.Should().ThrowAsync<InvalidOperationException>().WithMessage(message);
+            }
+
+            public async Task Fa_WithMessage_plain_local_fails()
+            {
+                var message = "not the message";
+                Func<Task> act = () => _client.CallAsync("a1");
+                await act.Should().ThrowAsync<InvalidOperationException>().WithMessage(message);
+            }
+
+            public async Task Fa_CompleteWithinAsync_value_type_local()
+            {
+                var timeout = TimeSpan.FromSeconds(30);
+                Func<Task> act = () => _client.WaitAsync();
+                await act.Should().CompleteWithinAsync(timeout);
+            }
+        }
+        """;
+
+    public static TheoryData<string> Methods() =>
+    [
+        "Issue_ThrowAsync_is_the_first_await",
+        "Issue_Unassigned_ThrowAsync_is_the_first_await",
+        "Shouldly_ThrowAsync_assigned_first_await",
+        "Shouldly_ThrowAsync_unassigned_first_await",
+        "Shouldly_NotThrowAsync_first_await",
+        "Shouldly_ThrowAsync_in_a_loop_after_an_await",
+        "Fa_WithMessage_reads_the_closure",
+        "Fa_WithMessage_plain_local",
+        "Fa_WithMessage_plain_local_fails",
+        "Fa_CompleteWithinAsync_value_type_local",
+    ];
+
+    private static readonly Lazy<string> DebugWoven = new(() => WovenRun.BuildAndWeave("Resume_Debug", Cases, OptimizationLevel.Debug));
+    private static readonly Lazy<string> ReleaseWoven = new(() => WovenRun.BuildAndWeave("Resume_Release", Cases, OptimizationLevel.Release));
+    private static readonly Lazy<string> ReleaseUnwoven = new(() => TestAssemblyBuilder.Build("Resume_Release_Unwoven", Cases, OptimizationLevel.Release));
+
+    [Theory]
+    [MemberData(nameof(Methods))]
+    public void A_woven_optimized_build_runs_as_the_unwoven_one(string method)
+    {
+        var (unwoven, _) = WovenRun.Run(ReleaseUnwoven.Value, "Cases", method);
+        var (woven, _) = WovenRun.Run(ReleaseWoven.Value, "Cases", method);
+
+        Assert.Equal(unwoven?.GetType(), woven?.GetType());
+        Assert.Equal(unwoven?.Message, woven?.Message);
+    }
+
+    [Theory]
+    [MemberData(nameof(Methods))]
+    public void An_optimized_build_draws_the_notes_a_debug_build_draws(string method)
+    {
+        var (_, debug) = WovenRun.Run(DebugWoven.Value, "Cases", method);
+        var (_, release) = WovenRun.Run(ReleaseWoven.Value, "Cases", method);
+
+        if (Environment.GetEnvironmentVariable("KRONIKOL_211_DUMP") is { Length: > 0 } dump)
+        {
+            lock (typeof(AwaitedAssertionResumeTests))
+                File.AppendAllText(dump, $"== {method}\nDebug:\n{string.Join("\n", debug.Select(n => "  " + n))}\nRelease:\n{string.Join("\n", release.Select(n => "  " + n))}\n");
+        }
+
+        // The assigned ThrowAsync draws no note in a Debug build (#212, AWAITED_ASSERTION_LABELS_PLAN.md): its row is
+        // compared once that plan's fix is in.
+        if (method is "Shouldly_ThrowAsync_assigned_first_await" or "Issue_ThrowAsync_is_the_first_await")
+            return;
+        Assert.Equal(debug.Select(WithoutFile), release.Select(WithoutFile));
+    }
+
+    // Each build is its own fixture file, so a note's source is compared by its line alone.
+    private static WovenRun.Note WithoutFile(WovenRun.Note note) =>
+        note with { Source = note.Source?[(note.Source.LastIndexOf(':') + 1)..] };
+
+    // A generic method's state machine is generic, and a field read in its MoveNext names the state machine as
+    // instantiated over its own parameters. Its own fixture: ILVerify reads the whole assembly, so one unverifiable
+    // method fails every case built with it.
+    private const string GenericCases = """
+        using System;
+        using System.Threading.Tasks;
+        using Kronikol.Tracking;
+        using Shouldly;
+
+        [assembly: TrackAssertions]
+
+        public sealed class Client
+        {
+            public async Task<string> CallAsync(string id)
+            {
+                await Task.Yield();
+                throw new InvalidOperationException("expected " + id);
+            }
+        }
+
+        public class Cases
+        {
+            private readonly Client _client = new();
+
+            public async Task Shouldly_ThrowAsync_in_a_generic_method() => await Generic("a1");
+
+            private async Task Generic<T>(T id)
+            {
+                var copy = id;
+                await Should.ThrowAsync<InvalidOperationException>(() => _client.CallAsync(copy!.ToString()!));
+            }
+        }
+        """;
+
+    [Theory]
+    [InlineData(OptimizationLevel.Debug)]
+    [InlineData(OptimizationLevel.Release)]
+    public void An_awaited_assertion_in_a_generic_method_verifies_and_runs(OptimizationLevel optimization)
+    {
+        var path = WovenRun.BuildAndWeave($"ResumeGeneric_{optimization}", GenericCases, optimization);
+
+        var (thrown, notes) = WovenRun.Run(path, "Cases", "Shouldly_ThrowAsync_in_a_generic_method");
+
+        Assert.Null(thrown);
+        Assert.Equal([true], notes.Select(n => n.Passed).ToArray());
+    }
+
+    // A closure that captures locals only, in an async method that never uses this: an optimized build keeps it on the
+    // stack (newobj; dup; stfld; ldftn), so no local holds it, and the state machine has no <>4__this field.
+    private const string StackClosureCases = """
+        using System;
+        using System.Threading.Tasks;
+        using FluentAssertions;
+        using Kronikol.Tracking;
+        using Shouldly;
+
+        [assembly: TrackAssertions]
+
+        public class Cases
+        {
+            public void Fa_Contain_expression_tree_closure_on_the_stack()
+            {
+                var id = "a1";
+                FluentAssertions.AssertionExtensions.Should(new[] { "a1" }).Contain(x => x == id);
+            }
+
+            public async Task Shouldly_ThrowAsync_closure_on_the_stack()
+            {
+                var id = "a1";
+                await Should.ThrowAsync<InvalidOperationException>(() => Task.FromException(new InvalidOperationException(id)));
+            }
+        }
+        """;
+
+    [Theory]
+    [InlineData(OptimizationLevel.Debug)]
+    [InlineData(OptimizationLevel.Release)]
+    public void A_closure_kept_on_the_stack_is_not_read_off_the_state_machine(OptimizationLevel optimization)
+    {
+        var path = WovenRun.BuildAndWeave($"ResumeStackClosure_{optimization}", StackClosureCases, optimization);
+
+        foreach (var method in new[] { "Shouldly_ThrowAsync_closure_on_the_stack", "Fa_Contain_expression_tree_closure_on_the_stack" })
+        {
+            var (thrown, notes) = WovenRun.Run(path, "Cases", method);
+
+            Assert.Null(thrown);
+            Assert.Equal([true], notes.Select(n => n.Passed).ToArray());
+        }
+    }
+}
