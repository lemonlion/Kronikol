+    /// <summary>
+    /// A field of a compiler-generated type, as code inside that type names it: through the type instantiated over its
+    /// own generic parameters when it has any (#211, D-B). A field definition named directly is the open type's, which
+    /// ILVerify rejects in a generic state machine's MoveNext.
+    /// </summary>
+    private static FieldReference OwnField(FieldDefinition field)
+    {
+        var type = field.DeclaringType;
+        if (!type.HasGenericParameters)
+            return field;
+        var instance = new GenericInstanceType(type);
+        foreach (var parameter in type.GenericParameters)
+            instance.GenericArguments.Add(parameter);
+        return new FieldReference(field.Name, field.FieldType, instance);
+    }
+
+    /// <summary>
+    /// The local of MoveNext a captured variable is read through: the closure's display class, or the variable itself;
+    /// -1 for one read through a field of the state machine or a parameter.
+    /// </summary>
+    private static int MoveNextLocal(CapturedVariable cv) =>
+        cv.ClosureField != null ? cv.ClosureLocalIndex :
+        cv.StateField == null && cv.ParameterIndex < 0 ? cv.LocalIndex : -1;
+
+    /// <summary>
+    /// Carries each local of MoveNext the awaited statement's values are read through across its await, in a field
+    /// of the state machine (#211), and returns the field for each variable it carries. The local is stored right
+    /// after the statement stores its awaiter: the stack is empty there, it runs on the path that completes at once
+    /// and on the one that suspends, and the statement has read every local it names. One field per local, shared by
+    /// the statements that carry it: each stores before it reads. Nothing is carried when the await is not the
+    /// compiler's shape (GetAwaiter, then a store of the awaiter) or the method is not an async state machine's.
+    /// </summary>
+    private static Dictionary<CapturedVariable, FieldReference> CarryAcrossAwait(
+        MethodDefinition method, ILProcessor il, AssertionStatement assertion, Instruction getResult)
+    {
+        var carried = new Dictionary<CapturedVariable, FieldReference>();
+        var stateMachine = method.DeclaringType;
+        if (method.Name != "MoveNext" ||
+            !stateMachine.Interfaces.Any(i => i.InterfaceType.FullName == "System.Runtime.CompilerServices.IAsyncStateMachine"))
+            return carried;
+
+        Instruction? getAwaiter = null;
+        for (var instr = assertion.FirstInstruction; instr != null && instr != getResult; instr = instr.Next)
+        {
+            if ((instr.OpCode == OpCodes.Call || instr.OpCode == OpCodes.Callvirt) &&
+                instr.Operand is MethodReference mr && mr.Name == "GetAwaiter")
+                getAwaiter = instr;
+        }
+        if (getAwaiter?.Next is not { } storeAwaiter || storeAwaiter.OpCode.Code != Code.Stloc)
+            return carried;
+
+        var at = storeAwaiter;
+        foreach (var cv in assertion.CapturedVariables)
+        {
+            var index = MoveNextLocal(cv);
+            if (index < 0)
+                continue;
+
+            var local = method.Body.Variables[index];
+            var name = $"<>krk__carried{index}";
+            var field = stateMachine.Fields.FirstOrDefault(f => f.Name == name);
+            if (field == null)
+            {
+                field = new FieldDefinition(name, Mono.Cecil.FieldAttributes.Private, local.VariableType);
+                stateMachine.Fields.Add(field);
+            }
+            var carrier = OwnField(field);
+
+            var load = il.Create(OpCodes.Ldarg_0);
+            il.InsertAfter(at, load);
+            var value = il.Create(OpCodes.Ldloc, local);
+            il.InsertAfter(load, value);
+            var store = il.Create(OpCodes.Stfld, carrier);
+            il.InsertAfter(value, store);
+            at = store;
+            carried[cv] = carrier;
+        }
+
+        return carried;
+    }
 }
 
