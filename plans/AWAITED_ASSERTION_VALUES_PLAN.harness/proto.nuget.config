<?xml version="1.0" encoding="utf-8"?>
<!-- For the prototype runs only: feed/ holds the prototype weaver packed as 5.12.1-proto211 (not committed; pack it
     with `dotnet pack src/Kronikol.AssertionTracking -c Release -p:Version=5.12.1-proto211 -o <harness>/feed`). -->
<configuration>
  <packageSources>
    <clear />
    <add key="proto" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
