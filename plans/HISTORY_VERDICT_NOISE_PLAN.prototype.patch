         TestName = span.TestName ?? wire.TestName,
         TraceId = span.TraceId ?? wire.TraceId,
         ActivityTraceId = span.ActivityTraceId ?? wire.ActivityTraceId,
diff --git a/tests/Kronikol.Tests/History/LedgerReplayProbe.cs b/tests/Kronikol.Tests/History/LedgerReplayProbe.cs
new file mode 100644
index 00000000..6ce899b3
--- /dev/null
+++ b/tests/Kronikol.Tests/History/LedgerReplayProbe.cs
@@ -0,0 +1,162 @@
+using System.Globalization;
+using System.Text;
+using Kronikol.History;
+
+namespace Kronikol.Tests.History;
+
+/// <summary>
+/// Throwaway probe (M0 in miniature): replays a real ledger, cutting it at each run, and dumps every
+/// non-stable verdict. REPLAY_LEDGER = the ledger, REPLAY_OUT = where to write, REPLAY_LAST = how many
+/// runs from the end to replay (default 3), REPLAY_MINRUNS = the consumer's HistoryMinRuns (default 3).
+/// </summary>
+public class LedgerReplayProbe
+{
+    /// <summary>What S4's pace adds at the history plan's size, 5,000 scenarios over 50 runs: REPLAY_COST=1, REPLAY_OUT.</summary>
+    [Fact]
+    public void Cost_of_pace()
+    {
+        var outPath = Environment.GetEnvironmentVariable("REPLAY_OUT");
+        if (Environment.GetEnvironmentVariable("REPLAY_COST") != "1" || string.IsNullOrEmpty(outPath))
+            return;
+
+        const int scenarios = 5000, window = 50;
+        var random = new Random(75);
+        var roster = HistoryRoster.Create("Suite", Enumerable.Range(0, scenarios).Select(i => new HistoryRosterEntry($"id{i:D8}", "Scenario " + i, "Feature", null)).ToArray());
+        var usual = Enumerable.Range(0, scenarios).Select(_ => random.Next(1, 2000)).ToArray();
+        var runs = Enumerable.Range(0, window + 1).Select(n => new HistoryRun
+        {
+            Id = $"local:{n}", Suite = roster.Suite, Partial = false,
+            At = new DateTimeOffset(2026, 9, 1, 0, 0, 0, TimeSpan.Zero).AddHours(n),
+            Branch = null, Commit = null, Provider = null, Url = null, Shards = 1, RosterHash = roster.Hash,
+            Results = new string('P', scenarios), Attempts = new string('1', scenarios),
+            Durations = usual.Select(u => (int?)Math.Max(0, (int)(u * (0.8 + random.NextDouble() * 0.4)))).ToArray(),
+            Errors = new string?[scenarios], ShapeSet = null, ShapeOrdered = null, Calls = null, ShapeVersion = null,
+            ErrorText = new Dictionary<string, string>(), Deps = []
+        }).ToList();
+        var rosters = runs.Select(_ => (HistoryRoster?)roster).ToList();
+
+        var output = new StringBuilder();
+        for (var attempt = 0; attempt < 5; attempt++)
+        {
+            var build = System.Diagnostics.Stopwatch.StartNew();
+            var paces = new HistoryAnalyzer.RunPaces(runs, rosters, null, new HistoryAnalysisOptions(), currentIsPartial: false);
+            build.Stop();
+            var read = System.Diagnostics.Stopwatch.StartNew();
+            double sum = 0;
+            foreach (var run in runs)
+                for (var i = 0; i < scenarios; i++)
+                    sum += paces.TimesUsual(run.Id, roster.Ids[i], 0, run.DurationAt(i), 'P') ?? 0;
+            read.Stop();
+            output.AppendLine(CultureInfo.InvariantCulture, $"attempt {attempt}: build {build.Elapsed.TotalMilliseconds:0.0} ms, {runs.Count * scenarios} TimesUsual reads {read.Elapsed.TotalMilliseconds:0.0} ms, pace of the last run {paces.Of(runs[^1].Id):0.00} (checksum {sum:0})");
+        }
+        File.WriteAllText(outPath, output.ToString());
+    }
+
+    [Fact]
+    public void Replay()
+    {
+        var path = Environment.GetEnvironmentVariable("REPLAY_LEDGER");
+        var outPath = Environment.GetEnvironmentVariable("REPLAY_OUT");
+        if (string.IsNullOrEmpty(path) || string.IsNullOrEmpty(outPath))
+            return;
+
+        var last = int.TryParse(Environment.GetEnvironmentVariable("REPLAY_LAST"), out var l) ? l : 3;
+        var minRuns = int.TryParse(Environment.GetEnvironmentVariable("REPLAY_MINRUNS"), out var m) ? m : 3;
+        var lines = File.ReadAllLines(path).Where(x => x.Length > 0).ToArray();
+        var runLines = lines.Select((text, index) => (text, index)).Where(x => x.text.StartsWith("{\"t\":\"run\"", StringComparison.Ordinal)).ToArray();
+
+        var output = new StringBuilder();
+        if (Environment.GetEnvironmentVariable("REPLAY_STATS") == "1")
+        {
+            // Every full run of every suite: candidate statistics for "degraded", one CSV row per run.
+            var whole = HistoryLedgerReader.Read(path, 0).Ledger!;
+            output.AppendLine("suite,run,n,p50,p75,p90,share2,n10,p50f10,p75f10,share2f10,n20,p75f20,share2f20");
+            foreach (var name in whole.Suites)
+            {
+                var ordered = whole.Runs(name).ToList();
+                var rosters = ordered.Select(r => whole.Roster(r.RosterHash)).ToList();
+                var paces = new HistoryAnalyzer.RunPaces(ordered, rosters, null, new HistoryAnalysisOptions { MinRuns = minRuns }, ordered[^1].Partial == true);
+                foreach (var run in ordered)
+                {
+                    var detail = paces.Ratios(run.Id);
+                    if (detail.Count < 5) continue;
+                    static double Q(List<double> sorted, double q) => sorted.Count == 0 ? 0 : sorted[Math.Min(sorted.Count - 1, (int)(sorted.Count * q))];
+                    var f0 = detail.Select(d => d.Ratio).OrderBy(v => v).ToList();
+                    var f10 = detail.Where(d => d.Usual >= 10).Select(d => d.Ratio).OrderBy(v => v).ToList();
+                    var f20 = detail.Where(d => d.Usual >= 20).Select(d => d.Ratio).OrderBy(v => v).ToList();
+                    static double Share(List<double> sorted) => sorted.Count == 0 ? 0 : sorted.Count(v => v >= 2.0) / (double)sorted.Count;
+                    output.AppendLine(string.Create(CultureInfo.InvariantCulture,
+                        $"{name},{run.Id},{f0.Count},{Q(f0, 0.5):0.00},{Q(f0, 0.75):0.00},{Q(f0, 0.9):0.00},{Share(f0):0.000},{f10.Count},{Q(f10, 0.5):0.00},{Q(f10, 0.75):0.00},{Share(f10):0.000},{f20.Count},{Q(f20, 0.75):0.00},{Share(f20):0.000}"));
+                }
+            }
+            File.WriteAllText(outPath, output.ToString());
+            return;
+        }
+
+        if (Environment.GetEnvironmentVariable("REPLAY_ALL_SUITES") == "1")
+        {
+            // Every suite's latest run, the whole stream as the window: the pace of every full run in it.
+            var whole = HistoryLedgerReader.Read(path, 0).Ledger!;
+            var all = new List<double>();
+            foreach (var name in whole.Suites)
+            {
+                var latest = whole.LatestRun(name)!;
+                var result = HistoryAnalyzer.Analyse(whole, whole.Roster(latest.RosterHash)!, latest, new HistoryAnalysisOptions { MinRuns = minRuns, Window = 0 });
+                var paced = result.Runs.Where(r => r.Pace is not null).Select(r => r.Pace!.Value).ToList();
+                all.AddRange(paced);
+                output.AppendLine(CultureInfo.InvariantCulture, $"{name} [{result.Stream}]: runs={result.Runs.Count} paced={paced.Count} max={(paced.Count > 0 ? paced.Max() : 0):0.00} degraded={result.Runs.Count(r => r.Degraded)}");
+            }
+            all.Sort();
+            if (all.Count > 0)
+                output.AppendLine(CultureInfo.InvariantCulture, $"ALL: n={all.Count} p05={all[(int)(all.Count * 0.05)]:0.00} p50={all[all.Count / 2]:0.00} p95={all[(int)(all.Count * 0.95)]:0.00} p99={all[(int)(all.Count * 0.99)]:0.00} max={all[^1]:0.00} >=1.5:{all.Count(v => v >= 1.5)} >=2:{all.Count(v => v >= 2)}");
+            File.WriteAllText(outPath, output.ToString());
+            return;
+        }
+
+        foreach (var (_, index) in runLines.Skip(Math.Max(0, runLines.Length - last)))
+        {
+            var cut = string.Join("\n", lines.Take(index + 1));
+            var ledger = HistoryLedgerReader.Parse(cut, 0).Ledger!;
+            var suite = ledger.Suites.Single();
+            var current = ledger.LatestRun(suite)!;
+            var roster = ledger.Roster(current.RosterHash)!;
+            var shapes = current.ShapesHash is { } hash ? ledger.Shapes(hash) : null;
+            var verdicts = HistoryAnalyzer.Analyse(ledger, roster, current, new HistoryAnalysisOptions { MinRuns = minRuns, DegradedLeavesDurations = Environment.GetEnvironmentVariable("REPLAY_DEGRADED_FILTER") != "0" }, shapes: shapes);
+
+            output.AppendLine(CultureInfo.InvariantCulture, $"=== {current.Id} partial={verdicts.Partial} scenarios={roster.Count} prior={verdicts.RunsRecorded}");
+            output.AppendLine("counts: " + string.Join(", ", verdicts.Counts.OrderBy(c => c.Key.ToString(), StringComparer.Ordinal).Select(c => $"{c.Key}={c.Value}")));
+            foreach (var scenario in verdicts.Scenarios.Where(s => s.Primary != HistoryVerdictKind.Stable).OrderBy(s => s.StableId, StringComparer.Ordinal))
+            {
+                output.AppendLine(CultureInfo.InvariantCulture, $"  [{scenario.VerdictNames}] {scenario.Feature} / {scenario.Name}");
+                output.AppendLine(CultureInfo.InvariantCulture, $"      {scenario.Evidence}");
+                output.AppendLine(CultureInfo.InvariantCulture, $"      duration={scenario.DurationMs} p95={scenario.DurationP95} calls={scenario.PreviousCalls}->{scenario.Calls} set={scenario.PreviousShapeSet}->{scenario.ShapeSet}");
+                foreach (var call in scenario.NewCalls)
+                    output.AppendLine("      + " + call);
+                foreach (var call in scenario.GoneCalls)
+                    output.AppendLine("      - " + call);
+            }
+
+            // S4: the pace of every run in the window, and what the notes would say about this run.
+            output.AppendLine("pace: " + string.Join(" ", verdicts.Runs.Select(r => (r.Partial ? "p" : "") + (r.Pace?.ToString("0.00", CultureInfo.InvariantCulture) ?? "-") + (r.Degraded ? "!" : ""))));
+            var ordered = ledger.Runs(suite).ToList();
+            var orderedRosters = ordered.Select(r => ledger.Roster(r.RosterHash)).ToList();
+            foreach (var floor in new[] { 0, 5, 20, 100 })
+            {
+                var floored = new HistoryAnalyzer.RunPaces(ordered, orderedRosters, null, new HistoryAnalysisOptions { MinRuns = minRuns }, verdicts.Partial, floor);
+                output.AppendLine(CultureInfo.InvariantCulture, $"pace of this run with a {floor} ms floor on the usual: {floored.Of(current.Id)?.ToString("0.00", CultureInfo.InvariantCulture) ?? "-"}");
+            }
+            var ratios = verdicts.Scenarios.Select(s => s.Points[^1]).Where(p => p.TimesUsual is not null && p.Result == 'P').Select(p => p.TimesUsual!.Value).OrderBy(v => v).ToList();
+            if (ratios.Count > 0)
+                output.AppendLine(CultureInfo.InvariantCulture, $"times usual, passing scenarios: n={ratios.Count} p10={ratios[(int)(ratios.Count * 0.10)]:0.00} p25={ratios[(int)(ratios.Count * 0.25)]:0.00} p50={ratios[ratios.Count / 2]:0.00} p75={ratios[(int)(ratios.Count * 0.75)]:0.00} p90={ratios[(int)(ratios.Count * 0.90)]:0.00} max={ratios[^1]:0.00}");
+            var noted = verdicts.Scenarios.Where(s => s.Points[^1] is { TimesUsual: >= 2.0, DurationMs: { } ms } p && ms - ms / p.TimesUsual >= 100).ToList();
+            output.AppendLine(CultureInfo.InvariantCulture, $"rows that would print (N× usual) with the 100 ms floor: {noted.Count}; failures in degraded runs, summed: {verdicts.Scenarios.Sum(s => s.FailuresInDegradedRuns)}");
+            foreach (var scenario in verdicts.Scenarios.Where(s => s.Current == 'F'))
+                output.AppendLine(CultureInfo.InvariantCulture, $"  FAILED [{scenario.VerdictNames}] {scenario.Name} :: {scenario.DurationMs} ms ({scenario.Points[^1].TimesUsual:0.0}× usual) :: {scenario.Evidence}");
+
+            // Every scenario's bar, so a p95 that moves without a verdict is still seen.
+            output.AppendLine("bars: " + string.Join(" ", verdicts.Scenarios.Select(s => $"{s.DurationMs?.ToString(CultureInfo.InvariantCulture) ?? "-"}/{s.DurationP95?.ToString(CultureInfo.InvariantCulture) ?? "-"}")));
+        }
+
+        File.WriteAllText(outPath, output.ToString());
+    }
+}
diff --git a/tests/Kronikol.Tests/History/NoisePlanDegradedTests.cs b/tests/Kronikol.Tests/History/NoisePlanDegradedTests.cs
new file mode 100644
index 00000000..a47083f9
--- /dev/null
+++ b/tests/Kronikol.Tests/History/NoisePlanDegradedTests.cs
@@ -0,0 +1,201 @@
+using Kronikol.History;
+
+namespace Kronikol.Tests.History;
+
+/// <summary>plans/HISTORY_VERDICT_NOISE_PLAN.md §6 (S4, #83): a run's pace, and what a degraded run may and may not say.</summary>
+public class NoisePlanDegradedTests
+{
+    private static readonly string[] Ids = Enumerable.Range(1, 20).Select(i => $"dddd{i:D12}").ToArray();
+
+    private static HistoryRoster Roster(string[] ids) =>
+        HistoryRoster.Create("Suite", ids.Select(id => new HistoryRosterEntry(id, "Scenario " + id, "Feature", null)).ToArray());
+
+    private static HistoryRun Run(HistoryRoster roster, int n, int?[] durations, string? results = null, bool partial = false) => new()
+    {
+        Id = $"local:{n}", Suite = roster.Suite, Partial = partial,
+        At = new DateTimeOffset(2026, 9, 1, 0, 0, 0, TimeSpan.Zero).AddHours(n),
+        Branch = null, Commit = null, Provider = null, Url = null, Shards = 1,
+        RosterHash = roster.Hash,
+        Results = results ?? new string('P', roster.Count), Attempts = new string('1', roster.Count),
+        Durations = durations, Errors = new string?[roster.Count],
+        ShapeSet = null, ShapeOrdered = null, Calls = null, ShapeVersion = null,
+        ErrorText = new Dictionary<string, string>(), Deps = []
+    };
+
+    private static HistoryLedger Ledger(IEnumerable<(HistoryRoster Roster, HistoryRun Run)> runs)
+    {
+        var text = HistoryJson.HeaderLine("test") + "\n";
+        var seen = new HashSet<string>();
+        foreach (var (roster, run) in runs)
+        {
+            if (seen.Add(roster.Hash)) text += HistoryJson.RosterLine(roster) + "\n";
+            text += HistoryJson.RunLine(run) + "\n";
+        }
+        return HistoryLedgerReader.Parse(text, window: 50).Ledger!;
+    }
+
+    /// <summary>Every scenario at <paramref name="others"/> milliseconds, the first at <paramref name="first"/>.</summary>
+    private static int?[] Durations(int first, int others = 1000) => [first, .. Enumerable.Repeat<int?>(others, 19)];
+
+    /// <summary>A machine under load: nine scenarios twice their usual, ten six times, and the first as given. Not uniform — measured, it never is.</summary>
+    private static int?[] Contended(int first) => [first, .. Enumerable.Repeat<int?>(2000, 9), .. Enumerable.Repeat<int?>(6000, 10)];
+
+    private static List<(HistoryRoster, HistoryRun)> Healthy(HistoryRoster roster, int runs) =>
+        Enumerable.Range(1, runs).Select(i => (roster, Run(roster, i, Durations(1000)))).ToList();
+
+    [Fact]
+    public void A_run_whose_passing_scenarios_took_three_times_their_usual_is_degraded()
+    {
+        var roster = Roster(Ids);
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(Healthy(roster, 6)), roster, Run(roster, 7, Durations(3000, 3000)), new HistoryAnalysisOptions());
+
+        Assert.Equal(3.0, verdicts.Runs[^1].Pace!.Value, 2);
+        Assert.True(verdicts.Runs[^1].Degraded);
+        Assert.All(verdicts.Runs.Take(6), run => Assert.False(run.Degraded));
+    }
+
+    [Fact]
+    public void One_scenario_thirty_times_slower_does_not_make_the_run_degraded()
+    {
+        var roster = Roster(Ids);
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(Healthy(roster, 6)), roster, Run(roster, 7, Durations(30_000)), new HistoryAnalysisOptions());
+
+        Assert.Equal(1.0, verdicts.Runs[^1].Pace!.Value, 2);
+        Assert.False(verdicts.Runs[^1].Degraded);
+        Assert.Equal(30.0, verdicts.Scenarios[0].Points[^1].TimesUsual!.Value, 2);
+    }
+
+    [Fact]
+    public void A_failure_in_a_degraded_run_says_so_and_the_same_failure_in_a_normal_run_does_not()
+    {
+        var roster = Roster(Ids);
+        var failed = "F" + new string('P', 19);
+        var degraded = HistoryAnalyzer.Analyse(Ledger(Healthy(roster, 6)), roster, Run(roster, 7, Contended(60_000), failed), new HistoryAnalysisOptions()).Scenarios[0];
+        var normal = HistoryAnalyzer.Analyse(Ledger(Healthy(roster, 6)), roster, Run(roster, 7, Durations(60_000), failed), new HistoryAnalysisOptions()).Scenarios[0];
+
+        Assert.Contains(HistoryVerdictKind.Broke, degraded.Verdicts);
+        Assert.Contains("this run was degraded: its passing scenarios took 6.0× their usual", degraded.Evidence);
+        Assert.Equal(1, degraded.FailuresInDegradedRuns);
+        Assert.Contains(HistoryVerdictKind.Broke, normal.Verdicts);
+        Assert.DoesNotContain("degraded", normal.Evidence);
+        Assert.Equal(0, normal.FailuresInDegradedRuns);
+    }
+
+    [Fact]
+    public void Failing_scenarios_do_not_move_the_pace()
+    {
+        var roster = Roster(Ids);
+        int?[] durations = [.. Enumerable.Repeat<int?>(60_000, 8), .. Enumerable.Repeat<int?>(1000, 12)];
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(Healthy(roster, 6)), roster, Run(roster, 7, durations, new string('F', 8) + new string('P', 12)), new HistoryAnalysisOptions());
+
+        Assert.Equal(1.0, verdicts.Runs[^1].Pace!.Value, 2);
+        Assert.False(verdicts.Runs[^1].Degraded);
+    }
+
+    [Fact]
+    public void A_partial_run_has_no_pace_and_is_in_no_scenarios_usual()
+    {
+        var roster = Roster(Ids);
+        var subset = Roster(Ids.Take(6).ToArray());
+        var runs = Healthy(roster, 3);
+        for (var i = 4; i <= 8; i++)
+            runs.Add((subset, Run(subset, i, Enumerable.Repeat<int?>(10_000, 6).ToArray(), partial: true)));
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 9, Durations(1000)), new HistoryAnalysisOptions { MinRuns = 3 });
+
+        Assert.All(verdicts.Runs.Where(run => run.Partial), run => Assert.Null(run.Pace));
+        Assert.Equal(1.0, verdicts.Runs[^1].Pace!.Value, 2);
+        Assert.Null(verdicts.Scenarios[0].Points[3].TimesUsual);
+    }
+
+    [Fact]
+    public void Issue_83_the_failing_reading_was_six_point_four_times_the_scenarios_usual()
+    {
+        var roster = Roster(Ids);
+        var verdicts = HistoryAnalyzer.Analyse(
+            Ledger([(roster, Run(roster, 1, Durations(12_502))), (roster, Run(roster, 2, Durations(13_034)))]),
+            roster, Run(roster, 3, Durations(82_215), "F" + new string('P', 19)), new HistoryAnalysisOptions { MinRuns = 2 });
+
+        Assert.Equal(6.44, verdicts.Scenarios[0].Points[^1].TimesUsual!.Value, 2);
+        Assert.False(verdicts.Runs[^1].Degraded);
+    }
+
+    // Measured: under contention a scenario that usually takes a few milliseconds barely registers the
+    // load, and the reverse — 3 ms read as 9 — is a timer tick. Neither is evidence about the machine.
+    [Fact]
+    public void Scenarios_that_usually_take_under_ten_milliseconds_do_not_vote()
+    {
+        var roster = Roster(Ids);
+        int?[] Mixed(int fast, int slow) => [.. Enumerable.Repeat<int?>(fast, 12), .. Enumerable.Repeat<int?>(slow, 8)];
+        var runs = Enumerable.Range(1, 6).Select(i => (roster, Run(roster, i, Mixed(3, 1000)))).ToList();
+
+        var onlyTheFastSlowed = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 7, Mixed(9, 1000)), new HistoryAnalysisOptions());
+        var onlyTheSlowSlowed = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 7, Mixed(3, 3000)), new HistoryAnalysisOptions());
+
+        Assert.Equal(1.0, onlyTheFastSlowed.Runs[^1].Pace!.Value, 2);
+        Assert.False(onlyTheFastSlowed.Runs[^1].Degraded);
+        Assert.Equal(3.0, onlyTheSlowSlowed.Runs[^1].Pace!.Value, 2);
+        Assert.True(onlyTheSlowSlowed.Runs[^1].Degraded);
+    }
+
+    [Fact]
+    public void A_suite_of_nothing_but_millisecond_scenarios_has_no_pace()
+    {
+        var roster = Roster(Ids);
+        var runs = Enumerable.Range(1, 6).Select(i => (roster, Run(roster, i, Durations(3, 3)))).ToList();
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 7, Durations(9, 9)), new HistoryAnalysisOptions());
+
+        Assert.Null(verdicts.Runs[^1].Pace);
+        Assert.False(verdicts.Runs[^1].Degraded);
+    }
+
+    // The limit the plan states rather than fixes: pace cannot tell a slow machine from a suite that
+    // really did get three times slower everywhere. It reads as degraded until the usual catches up,
+    // which is when the shifted runs are half the window, and then it stops by itself.
+    [Theory]
+    [InlineData(1, true)]
+    [InlineData(25, true)]
+    [InlineData(26, false)]
+    [InlineData(40, false)]
+    public void A_sustained_shift_reads_as_degraded_until_it_is_half_the_window(int shiftedRun, bool degraded)
+    {
+        var roster = Roster(Ids);
+        var runs = Enumerable.Range(1, 50).Select(i => (roster, Run(roster, i, Durations(1000)))).ToList();
+        for (var i = 1; i < shiftedRun; i++)
+            runs.Add((roster, Run(roster, 50 + i, Durations(3000, 3000))));
+        var verdicts = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 50 + shiftedRun, Durations(3000, 3000)), new HistoryAnalysisOptions());
+
+        Assert.Equal(degraded, verdicts.Runs[^1].Degraded);
+    }
+
+    // F8, found on the first real degraded run (BreakfastProvider, 2026-09-19): under contention the
+    // slowdown is not uniform, the run's median cannot absorb it, and every scenario whose previous
+    // reading happened to sit over its bar is handed a `slower` it did not earn.
+    [Theory]
+    [InlineData(false, true)]
+    [InlineData(true, false)]
+    public void A_degraded_run_does_not_hand_out_slower_verdicts(bool degradedLeavesDurations, bool slower)
+    {
+        var roster = Roster(Ids);
+        var runs = Healthy(roster, 7);
+        runs.Add((roster, Run(roster, 8, Durations(4000))));
+        var scenario = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 9, Contended(30_000)),
+            new HistoryAnalysisOptions { DegradedLeavesDurations = degradedLeavesDurations }).Scenarios[0];
+
+        Assert.Equal(slower, scenario.Verdicts.Contains(HistoryVerdictKind.Slower));
+    }
+
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(true, true)]
+    public void A_degraded_run_in_the_window_does_not_hide_a_real_slowdown(bool degradedLeavesDurations, bool slower)
+    {
+        var roster = Roster(Ids);
+        var runs = Healthy(roster, 7);
+        runs.Add((roster, Run(roster, 8, Contended(30_000))));
+        runs.Add((roster, Run(roster, 9, Durations(2500))));
+        var scenario = HistoryAnalyzer.Analyse(Ledger(runs), roster, Run(roster, 10, Durations(2500)),
+            new HistoryAnalysisOptions { DegradedLeavesDurations = degradedLeavesDurations }).Scenarios[0];
+
+        Assert.Equal(slower, scenario.Verdicts.Contains(HistoryVerdictKind.Slower));
+    }
+}
