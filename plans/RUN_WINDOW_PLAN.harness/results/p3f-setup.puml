@startuml
!pragma teoz true
skinparam defaultFontName system-ui
skinparam shadowing false
skinparam SequenceMessagePadding 4
skinparam sequenceMessageAlignment center
<style>
sequenceDiagram { participant { RoundCorner 12; Padding 8 14; Margin 0 10; LineThickness 1 } }
sequenceDiagram { actor, database, queue, collections, boundary, control, entity { Margin 0 10; LineThickness 1 } }
sequenceDiagram { lifeLine { LineStyle 0; LineThickness 1 } }
sequenceDiagram { note { LineThickness 1 } }
</style>


skinparam wrapWidth 800
autonumber 1

actor "seeder" as seeder
participant "Database" as database
participant "compose" as compose
participant "Orders Api" as ordersApi

partition #F6F6F6 Setup
seeder -[#438DD5]> database: POST: /insert?seed=0
database -[#438DD5]-> seeder: OK
seeder -[#438DD5]> database: POST: /insert?seed=1
database -[#438DD5]-> seeder: OK
seeder -[#438DD5]> database: POST: /insert?seed=2
database -[#438DD5]-> seeder: OK
seeder -[#438DD5]> database: POST: /insert?seed=3
database -[#438DD5]-> seeder: OK
seeder -[#438DD5]> database: POST: /insert?seed=4
database -[#438DD5]-> seeder: OK
seeder -[#438DD5]> database: POST: /insert?seed=5
database -[#438DD5]-> seeder: OK
loop ×2 · 10 ms
compose -[#438DD5]> ordersApi: GET: /health
ordersApi -[#438DD5]-> compose: OK
end
end
@enduml
