<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Xunit.DependencyInjection 9.9.2 (the last version on xunit 2.x) composed with the prototype. Its framework
    class is sealed and its [assembly: TestFramework] is generated by the package's MSBuild targets, so the
    generated attribute is switched off and KronikolDiFramework (an ITestFramework holding the DI framework)
    is registered instead.
  -->
  <PropertyGroup>
    <EnableXunitDependencyInjectionDefaultTestFrameworkAttribute>false</EnableXunitDependencyInjectionDefaultTestFrameworkAttribute>
    <!-- The package's default is $(AssemblyName).Startup. -->
    <XunitStartupFullName>Probe.Di.Startup</XunitStartupFullName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xunit.DependencyInjection" Version="9.9.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
    <!-- The prototype without PrototypeFramework.cs, which subclasses AssemblyFixtureFramework. -->
    <Compile Include="../Prototype/Prototype.cs;../Prototype/ProbeLog.cs" />
  </ItemGroup>
</Project>
