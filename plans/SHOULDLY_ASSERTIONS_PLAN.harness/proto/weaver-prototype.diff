-        for (var i = shouldIdx + 1; i < statementInstructions.Count; i++)
+        // Scan instructions after Should (PROTOTYPE: before the call for Shouldly, whose arguments precede it)
+        var shouldly = Environment.GetEnvironmentVariable("PROTO_CAPTURE_BEFORE") == "1" &&
+                       statementInstructions[shouldIdx].Operand is MethodReference entryRef && IsShouldlyEntryPoint(entryRef);
+        var scanFrom = shouldly ? 0 : shouldIdx + 1;
+        var scanTo = shouldly ? shouldIdx : statementInstructions.Count;
+        for (var i = scanFrom; i < scanTo; i++)
         {
             var instr = statementInstructions[i];
 
@@ -1676,7 +1689,8 @@ private void WrapAssertions(
