         if (firstInstr.OpCode.StackBehaviourPop == StackBehaviour.Pop0 &&
-            firstInstr.OpCode != OpCodes.Dup)
+            firstInstr.OpCode != OpCodes.Dup &&
+            Environment.GetEnvironmentVariable("PROTO_SPILL_POP0") != "1")
         {
             return null;
         }
