<Project Sdk="Microsoft.NET.Sdk">
  <!-- Does <NoWarn> silence a coded warning that a task logs (as #144's warning would be)? -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <UsingTask TaskName="WarnTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Log.LogWarning(subcategory: null, warningCode: "KRONIKOL001", helpKeyword: null, file: null,
          lineNumber: 0, columnNumber: 0, endLineNumber: 0, endColumnNumber: 0,
          message: "probe warning from a task");
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ProbeWarn" AfterTargets="CoreCompile">
    <WarnTask />
  </Target>
</Project>
