<Project Sdk="Microsoft.NET.Sdk">
  <!--
    S0 probe for ASSERTION_VALUE_SUBSTITUTION_PLAN.md (#163). A console app with no test framework, as
    SHOULDLY_ASSERTIONS_PLAN's probe: Track.TestIdResolver names a test per case, and the assertion notes are read
    back from RequestResponseLogger. Three families of case:
      Woven*  real Shouldly 4.3.0 and FluentAssertions 6.12.1 statements, woven at build time (the issue's stack)
      That*   the same shapes through Track.That (ClosureValueResolver), in a type the weave leaves alone
      Direct* Track.AssertionPassedWithValues called with a statement's text and the values the weave would pass,
              for shapes a woven statement cannot reach (a getter that throws, a null root, TUnit's text)
    -p:KronikolVersion=<v>  the published Kronikol packages to weave with (default 4.14.6, the repo at planning time)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS1718</NoWarn>
    <KronikolVersion Condition="'$(KronikolVersion)' == ''">4.14.6</KronikolVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kronikol" Version="$(KronikolVersion)" />
    <PackageReference Include="Kronikol.AssertionTracking" Version="$(KronikolVersion)" PrivateAssets="all" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>
</Project>
