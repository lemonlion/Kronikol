<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- audit B E5: the probe package lands here, not in the user's global cache -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <fallbackPackageFolders>
    <add key="user-global" value="C:\Users\cex\.nuget\packages" />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="local-probe-feed" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
