<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS8600;CS8618;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <Reference Include="Kronikol"><HintPath>lib/Kronikol.dll</HintPath></Reference>
    <Reference Include="Kronikol.Extensions.Kafka"><HintPath>lib/Kronikol.Extensions.Kafka.dll</HintPath></Reference>
  </ItemGroup>
</Project>
