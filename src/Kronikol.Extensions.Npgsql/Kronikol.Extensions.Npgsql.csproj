<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams PostgreSQL (Npgsql) Extension</Title>
    <Description>PostgreSQL tracking for test diagrams via DiagnosticSource. Automatically intercepts all Npgsql SQL operations with zero production code changes. Classifies queries (Select, Insert, Update, Delete, Upsert, Merge, StoredProcedure, DDL) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Npgsql: 10.0.0 is the oldest 10.x the suite passes on, the first of the major, and its graph carries no known
         advisory (harness floor/r3b-npgsql.txt). FloorLedger holds the floor, and the test project's package fact reads
         it back from the packed nuspec; the suite runs on the newest 10.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
