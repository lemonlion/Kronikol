<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams ClickHouse.Driver Pairing Extension</Title>
    <Description>Pairs Kronikol.Extensions.ClickHouse with ClickHouse.Driver, the official ClickHouse .NET client (HTTP). Adds compile-time driver integration: accurate rows-affected counts for INSERTs (read from the driver's QueryStats, populated from the X-ClickHouse-Summary response header — its ExecuteNonQuery return value is always 0 for INSERTs) plus typed wrap/DI registration helpers. Also tracks the driver's IClickHouseClient (InsertBinaryAsync drawn as one INSERT with its rows) and IClickHouseDataSource.GetClient(), wrapped or decorated through DI.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.ClickHouse" />
  </ItemGroup>
  <ItemGroup>
    <!-- ClickHouse.Driver: 1.3.0 is the oldest 1.x the package builds on, as it wraps client members 1.3.0 added
         (QueryAsync and the insert type registrations), and the suite passes on it against a ClickHouse 25.8 server;
         its graph carries no known advisory (harness floor/r3b-clickhouse-driver.txt). FloorLedger holds the floor, and
         the test project's package fact reads it back from the packed nuspec; the suite runs on the newest 1.x, and on
         this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="ClickHouse.Driver" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol.Extensions.ClickHouse\Kronikol.Extensions.ClickHouse.csproj" />
  </ItemGroup>
</Project>
