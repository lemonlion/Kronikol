<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams ClickHouse.Driver Pairing Extension</Title>
    <Description>Pairs Kronikol.Extensions.ClickHouse with ClickHouse.Driver, the official ClickHouse .NET client (HTTP). Adds compile-time driver integration: accurate rows-affected counts for INSERTs (read from the driver's QueryStats, populated from the X-ClickHouse-Summary response header — its ExecuteNonQuery return value is always 0 for INSERTs) plus typed wrap/DI registration helpers.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.ClickHouse" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol.Extensions.ClickHouse\Kronikol.Extensions.ClickHouse.csproj" />
  </ItemGroup>
</Project>
