<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams MySQL (MySqlConnector) Extension</Title>
    <Description>MySQL tracking for test diagrams via DiagnosticSource. Automatically intercepts all MySqlConnector SQL operations with zero production code changes. Classifies queries with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <!-- MySqlConnector: 2.6.1, the first release past GHSA-473q-m89c-ghf8 (published 2026-10-28; before 2.6.1, the
         client in zero-configuration TLS mode sends the password before it has verified the server's certificate).
         R3b measures the floor (plans/CLIENT_FLOORS_PLAN.md F10). -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
