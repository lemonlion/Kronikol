<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Oracle Extension</Title>
    <Description>Oracle tracking for test diagrams via DbConnection wrapping. Intercepts and classifies SQL operations from Oracle.ManagedDataAccess connections with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.Oracle" />
  </ItemGroup>
  <ItemGroup>
    <!-- Oracle.ManagedDataAccess.Core: 23.4.0, the first of the major, where the suite passes; every 23.x release, the
         newest included, asks for a System.Security.Cryptography.Pkcs under GHSA-846f-f764-76mx (high) and
         GHSA-2fmv-rv2c-59x7 (moderate), which the reference below lifts (harness floor/r2c-oracle.txt). FloorLedger
         holds the floor, and the test project's package fact reads it back from the packed nuspec; the suite runs on the
         newest 23.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R2c). -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.4.0" />
    <!-- System.Security.Cryptography.Pkcs: 8.0.2, the first release past GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7
         (moderate), under which falls the Pkcs that every Oracle.ManagedDataAccess.Core 23.x asks for; the package asks
         for 8.0.2 so that the graph it hands its consumers is past both (plans/CLIENT_FLOORS_PLAN.md R2c). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
