<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Title>Test Tracking Diagrams Assertion Tracking</Title>
    <Description>IL weaver that draws each assertion in a test as a note in its Kronikol diagram and a sub-step in its step list, passed or failed, with the values it compared. It instruments the assertion statements of FluentAssertions and AwesomeAssertions (.Should()) and TUnit (Assert.That()) in the compiled IL, so C# semantics such as null propagation, ref parameters and evaluation order are unchanged. Turn it on with [assembly: TrackAssertions].</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <!-- MSBuild task packaging: output DLLs to tasks/ folder in nupkg -->
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5129</NoWarn>

    <!-- Do not multi-target; MSBuild tasks must be netstandard2.0 -->
    <MultiTargetFrameworks />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" PrivateAssets="all" ExcludeAssets="Runtime" />
  </ItemGroup>

  <!-- Include MSBuild integration files in the package -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Bundle Cecil and other dependency DLLs alongside the task DLL in the nupkg -->
  <Target Name="_IncludeTaskDependenciesInPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_TaskDependency Include="$(OutputPath)*.dll" Exclude="$(OutputPath)Kronikol.AssertionTracking.dll" />
      <_PackageFiles Include="@(_TaskDependency)" PackagePath="tasks\netstandard2.0\" />
    </ItemGroup>
  </Target>

</Project>
