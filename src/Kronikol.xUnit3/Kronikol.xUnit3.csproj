<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework />
		<TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
		<Title>Test Tracking Diagrams For XUnit v3</Title>
		<Description>xUnit v3 extensions for tracking service interactions (HTTP, database, cache, events, and more) in your tests and converting them into PlantUML sequence diagrams.</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<IsTestProject>false</IsTestProject>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!-- xunit.v3.extensibility.core: 3.0.0 is the oldest 3.x the suite passes on, each probe with xunit.v3 of the same
		     release, the first of the major, and its graph carries no known advisory (harness floor/r3a-xunit3.txt).
		     FloorLedger holds the floor, and the test project's package fact reads it back from the packed nuspec; the suite
		     runs on the newest 3.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3a). -->
		<PackageReference Include="xunit.v3.extensibility.core" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kronikol\Kronikol.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kronikol.BDDfy.xUnit3" />
		<InternalsVisibleTo Include="Kronikol.LightBDD.xUnit3" />
		<InternalsVisibleTo Include="Kronikol.Tests" />
		<InternalsVisibleTo Include="Kronikol.Tests.xUnit3" />
	</ItemGroup>

</Project>