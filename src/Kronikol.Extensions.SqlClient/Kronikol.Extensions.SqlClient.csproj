<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams SQL Server (SqlClient) Extension</Title>
    <Description>SQL Server tracking for test diagrams via DiagnosticSource. Automatically intercepts all Microsoft.Data.SqlClient SQL operations with zero production code changes. Classifies queries with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- Microsoft.Data.SqlClient 2.x has vulnerable transitive deps (IdentityModel, System.Drawing.Common).
         We use 2.x to support consumers on older versions. These are test-time only packages. -->
    <NoWarn>$(NoWarn);NU1902;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Data.SqlClient: 7.0.0 is the oldest 7.x the suite passes on, the first of the major; every 7.x, the
         newest included, brings a System.Security.Cryptography.Pkcs under GHSA-846f-f764-76mx (high) and
         GHSA-2fmv-rv2c-59x7 (moderate), which the reference below lifts (harness floor/r3b-sqlclient.txt). FloorLedger
         holds the floor, and the test project's package fact reads it back from the packed nuspec; the suite runs on
         the newest 7.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <!-- System.Security.Cryptography.Pkcs: 9.0.21, the first 9.x past GHSA-846f-f764-76mx (high) and
         GHSA-2fmv-rv2c-59x7 (moderate), under which falls the Pkcs that every Microsoft.Data.SqlClient 7.x asks for
         (9.0.13 to 9.0.18); the package asks for 9.0.21 so that the graph it hands its consumers is past both
         (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
