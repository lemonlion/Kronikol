<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams MassTransit Extension</Title>
    <Description>MassTransit message tracking for test diagrams. Intercepts and classifies Send, Publish, and Consume operations across RabbitMQ, Azure Service Bus, Amazon SQS, and other transports with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- MassTransit: 9.0.0 is the oldest 9.x the suite passes on, the first of the major, and its graph carries no
         known advisory (harness floor/r3b-masstransit.txt). FloorLedger holds the floor, and the test project's package
         fact reads it back from the packed nuspec; the suite runs on the newest 9.x, and on this floor with
         -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="MassTransit" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
