<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams DispatchProxy Extension</Title>
    <Description>DI integration helpers for TrackingProxy&lt;T&gt;. Provides ReplaceWithTracked&lt;T&gt;() extension method for IServiceCollection to replace service registrations with tracking proxies that record interactions for diagrams.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions: 10.0.0 is the oldest 10.x the suite passes on, the first
         of the major, each probe with the container of the same release, now that the Kronikol core asks for
         Microsoft.AspNetCore.Mvc.Testing 10.0.0; its graph carries no known advisory (harness
         floor/r3a-di-dispatchproxy.txt). FloorLedger holds the floor, and the test project's package fact reads it back
         from the packed nuspec; the suite runs on the newest 10.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R3a). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
