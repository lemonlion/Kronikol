<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams MediatR Extension</Title>
    <Description>MediatR/CQRS tracking for test diagrams. Wraps IMediator and ISender with TrackingProxy to record Send, Publish, and CreateStream calls with command/query type names as diagram labels.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR: 14.0.0 is the oldest 14.x the suite passes on, the first of the major, and its graph carries no known
         advisory (harness floor/r3b-mediatr.txt) (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="MediatR" Version="14.0.0" />
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions: 10.0.0 is the oldest 10.x the suite passes on, the first
         of the major, each probe with the container and the logging of the same release, as MediatR 14.1.0 asks for
         10.0.0 and the Kronikol core no longer asks for more; its graph carries no known advisory (harness
         floor/r3a-di-mediatr.txt). FloorLedger holds the floor, and the test project's package fact reads it back from
         the packed nuspec; the suite runs on the newest 10.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R3a). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
