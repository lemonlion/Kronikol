<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework />
	  <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
	  <Title>Test Tracking Diagrams For LightBDD xUnit3</Title>
	  <Description>LightBDD + xUnit 3 extensions for tracking service interactions (HTTP, database, cache, events, and more) in your tests and converting them into PlantUML sequence diagrams.</Description>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- LightBDD.XUnit3: 3.12.0, its first release, is the oldest the suite passes on, and its graph carries no known
         advisory (harness floor/r3a-lightbdd-xunit3.txt). FloorLedger holds the floor, and the test project's package
         fact reads it back from the packed nuspec; the suite runs on the newest 3.x, and on this floor with
         -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3a). -->
    <PackageReference Include="LightBDD.XUnit3" Version="3.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol.LightBDD.Core\Kronikol.LightBDD.Core.csproj" />
    <ProjectReference Include="..\Kronikol.xUnit3\Kronikol.xUnit3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests" />
    <InternalsVisibleTo Include="Kronikol.Tests.LightBDD.xUnit3" />
  </ItemGroup>

</Project>
