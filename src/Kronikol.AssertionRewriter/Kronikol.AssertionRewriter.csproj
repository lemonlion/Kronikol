<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Title>Test Tracking Diagrams Assertion Rewriter</Title>
    <Description>MSBuild task that automatically wraps FluentAssertions .Should() expressions in Track.That() at compile time. Activated via [assembly: TrackAssertions]. Zero runtime footprint — operates on source files before compilation.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <!-- MSBuild task packaging: output DLLs to tasks/ folder in nupkg -->
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>

    <!-- Do not multi-target; MSBuild tasks must be netstandard2.0 -->
    <MultiTargetFrameworks />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.AssertionRewriter" />
  </ItemGroup>

  <!-- Include MSBuild integration files in the package -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Bundle Roslyn and other dependency DLLs alongside the task DLL in the nupkg -->
  <Target Name="_IncludeTaskDependenciesInPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_TaskDependency Include="$(OutputPath)*.dll" Exclude="$(OutputPath)Kronikol.AssertionRewriter.dll" />
      <_PackageFiles Include="@(_TaskDependency)" PackagePath="tasks\netstandard2.0\" />
    </ItemGroup>
  </Target>

</Project>
