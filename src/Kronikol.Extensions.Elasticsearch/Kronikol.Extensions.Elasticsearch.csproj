<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Elasticsearch Extension</Title>
    <Description>Elasticsearch tracking for test diagrams. Intercepts and classifies index, search, document, and cluster operations via the Elastic .NET client with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.Elasticsearch" />
  </ItemGroup>
  <ItemGroup>
    <!-- Elastic.Clients.Elasticsearch: 9.0.0 is the oldest 9.x the suite passes on, the first of the major, and its
         graph carries no known advisory (harness floor/r3b-elasticsearch.txt). FloorLedger holds the floor, and the
         test project's package fact reads it back from the packed nuspec; the suite runs on the newest 9.x, and on this
         floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
