<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework />
	  <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
	  <Title>Test Tracking Diagrams For NUnit 4</Title>
	  <Description>NUnit 4 extensions for tracking service interactions (HTTP, database, cache, events, and more) in your tests and converting them into PlantUML sequence diagrams. This is the renamed successor to Kronikol.NUnit3.</Description>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit: 4.6.0 is the oldest 4.x the suite passes on: on 4.5.x only UncapturedTestsTests fails, the guard on the
         result tree of NUnit.Framework.Internal that the adapter reads, and 4.3.0 and older have no
         TestContext.TestAdapter.MethodInfo, which the adapter reads; its graph carries no known advisory (harness
         floor/r3a-nunit4.txt). FloorLedger holds the floor, and the test project's package fact reads it back from the
         packed nuspec; the suite runs on the newest 4.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R3a). -->
    <PackageReference Include="NUnit" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.NUnit4" />
  </ItemGroup>

</Project>
