<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Kronikol</Title>
    <!-- "formerly TestTrackingDiagrams" stays in the description on purpose: the old identity still ranks
         first for the capability query and carries most of the ~3M lifetime downloads (LLM_FIRST_PLAN H1). -->
    <Description>Kronikol, formerly TestTrackingDiagrams. Autogenerate PlantUML sequence diagrams from your component and acceptance tests. Tracks HTTP calls, database operations (Cosmos DB, SQL via EF Core), Redis commands, events/messages, and arbitrary method calls, then converts them into searchable HTML reports and structured data files.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kronikol.Tests" />
		<InternalsVisibleTo Include="Kronikol.Tests.EndToEnd" />
		<!-- width regression facts render the step bar / assertion note emitters through real Java PlantUML -->
		<InternalsVisibleTo Include="Kronikol.Tests.PlantUml.Ikvm" />
		<InternalsVisibleTo Include="Kronikol.Tool" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Grpc" />
		<InternalsVisibleTo Include="Kronikol.Extensions.ClickHouse.Driver" />
		<!-- search-index bench harness (tools/search-bench/formatter-probe), query-bench precedent -->
		<InternalsVisibleTo Include="formatter-probe" />
	</ItemGroup>

	<!-- The query engine behind `kronikol query` and the query.cs written beside every report
	     (plans/QUERY_FALLBACK_PLAN.md). Compiled for .NET 10 and later only: query.cs loads the net10.0
	     build, which every consumer's NuGet cache holds whatever it targets, so the net8.0 and net9.0
	     builds carry none of it and are unchanged by it. -->
	<ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
		<Compile Remove="Query\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="PlantUml\plantuml-render.js" />
		<EmbeddedResource Include="Reports\advanced-search.js" />
		<EmbeddedResource Include="Reports\stylesheets.css" />
		<EmbeddedResource Include="Reports\history-styles.css" />
		<EmbeddedResource Include="Reports\report-diagnostics-styles.css" />
		<EmbeddedResource Include="Reports\labs-styles.css" />
		<EmbeddedResource Include="Reports\context-menu-styles.css" />
		<EmbeddedResource Include="Reports\inline-svg-styles.css" />
		<EmbeddedResource Include="Reports\collapsible-notes-styles.css" />
		<EmbeddedResource Include="Reports\internal-flow-popup-styles.css" />
		<EmbeddedResource Include="Reports\context-menu-script.js" />
		<EmbeddedResource Include="Reports\internal-flow-popup-script.js" />
		<EmbeddedResource Include="Reports\toggle-script.js" />
		<EmbeddedResource Include="Reports\diagram-toggle-layout-script.js" />
		<EmbeddedResource Include="Reports\flame-chart-render-script.js" />
		<EmbeddedResource Include="Reports\collapsible-notes-script.js" />
		<EmbeddedResource Include="Reports\plantuml-browser-render-script.js" />
		<EmbeddedResource Include="Reports\plantuml-worker-host.js" />
		<EmbeddedResource Include="Reports\report-*.js" />
		<EmbeddedResource Include="Reports\agent-instructions.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.26" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.15" Condition="'$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

</Project>
