<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Kronikol</Title>
    <!-- "formerly TestTrackingDiagrams" stays in the description on purpose: the old identity still ranks
         first for the capability query and carries most of the ~3M lifetime downloads (LLM_FIRST_PLAN H1). -->
    <Description>Kronikol, formerly TestTrackingDiagrams. Autogenerate PlantUML sequence diagrams from your component and acceptance tests. Tracks HTTP calls, database operations (Cosmos DB, SQL via EF Core), Redis commands, events/messages, and arbitrary method calls, then converts them into searchable HTML reports and structured data files.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- For the ZstdSharp copy in Compression\Zstd alone, which is a translation of C and unsafe throughout; a fact
         holds every other file free of unsafe code (plans/REPORT_FORMAT_PLAN.md 4.10). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kronikol.Tests" />
		<InternalsVisibleTo Include="Kronikol.Tests.EndToEnd" />
		<!-- width regression facts render the step bar / assertion note emitters through real Java PlantUML -->
		<InternalsVisibleTo Include="Kronikol.Tests.PlantUml.Ikvm" />
		<InternalsVisibleTo Include="Kronikol.Tool" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Grpc" />
		<!-- TrackingHeaderValue: the identity headers' UTF-8'' form, written and read by these two as well -->
		<InternalsVisibleTo Include="Kronikol.Extensions.ProxyTap" />
		<InternalsVisibleTo Include="Kronikol.Playwright" />
		<InternalsVisibleTo Include="Kronikol.Extensions.ClickHouse.Driver" />
		<!-- ScenarioTitleResolver.FormatXunitDisplayName: an xUnit display name read with the test's own DisplayName -->
		<InternalsVisibleTo Include="Kronikol.xUnit2" />
		<InternalsVisibleTo Include="Kronikol.xUnit3" />
		<!-- ProcessDiagnostics: build interception records at setup that tiered compilation can end it -->
		<InternalsVisibleTo Include="Kronikol.Extensions.Kafka.BuildInterception" />
		<InternalsVisibleTo Include="Kronikol.Tests.Kafka.BuildInterception" />
		<!-- SqlRowFormatter.ValueText: a scalar or parameter written as a row's value is, the same on every machine -->
		<InternalsVisibleTo Include="Kronikol.Extensions.SqlClient" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Npgsql" />
		<InternalsVisibleTo Include="Kronikol.Extensions.MySqlConnector" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Oracle" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Sqlite" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Dapper" />
		<InternalsVisibleTo Include="Kronikol.Extensions.EfCore.Relational" />
		<InternalsVisibleTo Include="Kronikol.Extensions.ClickHouse" />
		<InternalsVisibleTo Include="Kronikol.Extensions.Spanner" />
		<!-- InternalFlowActivityListener: the Kafka trackers start it, as the HTTP handler and gRPC interceptor do -->
		<InternalsVisibleTo Include="Kronikol.Extensions.Kafka" />
		<InternalsVisibleTo Include="Kronikol.Extensions.MongoDB" />
		<InternalsVisibleTo Include="Kronikol.Extensions.MongoDB.V2" />
		<InternalsVisibleTo Include="Kronikol.Tests.MongoDB" />
		<InternalsVisibleTo Include="Kronikol.Tests.MongoDB.V2" />
		<InternalsVisibleTo Include="Kronikol.Tests.Kafka" />
		<!-- search-index bench harness (tools/search-bench/formatter-probe), query-bench precedent -->
		<InternalsVisibleTo Include="formatter-probe" />
	</ItemGroup>

	<!-- zstd for the report data file comes from a source copy of ZstdSharp below .NET 11, and from .NET's own
	     ZstandardStream from .NET 11 on (plans/REPORT_FORMAT_PLAN.md 4.10). The copy is imported by
	     tools/vendor-zstd and never edited by hand. -->
	<ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
		<Compile Remove="Compression\Zstd\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Link="THIRD-PARTY-NOTICES.md" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="PlantUml\plantuml-render.js" />
		<EmbeddedResource Include="Reports\advanced-search.js" />
		<EmbeddedResource Include="Reports\report-tokens.css" />
		<EmbeddedResource Include="Reports\stylesheets.css" />
		<EmbeddedResource Include="Reports\history-styles.css" />
		<EmbeddedResource Include="Reports\warm-up-styles.css" />
		<EmbeddedResource Include="Reports\report-diagnostics-styles.css" />
		<EmbeddedResource Include="Reports\labs-styles.css" />
		<EmbeddedResource Include="Reports\context-menu-styles.css" />
		<EmbeddedResource Include="Reports\inline-svg-styles.css" />
		<EmbeddedResource Include="Reports\collapsible-notes-styles.css" />
		<EmbeddedResource Include="Reports\internal-flow-popup-styles.css" />
		<EmbeddedResource Include="Reports\context-menu-script.js" />
		<EmbeddedResource Include="Reports\internal-flow-popup-script.js" />
		<EmbeddedResource Include="Reports\toggle-script.js" />
		<EmbeddedResource Include="Reports\diagram-toggle-layout-script.js" />
		<EmbeddedResource Include="Reports\flame-chart-render-script.js" />
		<EmbeddedResource Include="Reports\collapsible-notes-script.js" />
		<EmbeddedResource Include="Reports\plantuml-browser-render-script.js" />
		<EmbeddedResource Include="Reports\plantuml-worker-host.js" />
		<EmbeddedResource Include="Reports\report-*.js" />
		<EmbeddedResource Include="Reports\agent-instructions.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

</Project>
