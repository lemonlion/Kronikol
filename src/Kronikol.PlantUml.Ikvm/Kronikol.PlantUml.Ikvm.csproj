<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams PlantUML IKVM</Title>
    <Description>Local PlantUML rendering via IKVM for Kronikol. Generates diagrams without requiring a remote PlantUML server.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.PlantUml.Ikvm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IKVM" Version="8.15.0" />
    <PackageReference Include="IKVM.Image" Version="8.15.0" />
    <PackageReference Include="IKVM.Image.JDK" Version="8.15.0" />
    <PackageReference Include="IKVM.Image.JRE" Version="8.15.0" />
    <PackageReference Include="IKVM.MSBuild" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <IkvmReference Include="PlantUml\plantuml-mit-1.2024.6.jar">
      <Debug>true</Debug>
    </IkvmReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
