<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Octonica ClickHouse Pairing Extension</Title>
    <Description>Pairs Kronikol.Extensions.ClickHouse with the Octonica.ClickHouseClient (native TCP) driver: typed wrap/DI registration helpers and a compile-time driver adapter (Octonica's ExecuteNonQuery already returns real written-row counts, so the adapter passes them through).</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Octonica.ClickHouseClient: 3.1.1 is the oldest 3.x the suite passes on, the first of the major, and its graph
         carries no known advisory (harness floor/r3b-clickhouse-octonica.txt). FloorLedger holds the floor, and the
         test project's package fact reads it back from the packed nuspec; the suite runs on the newest 3.x, and on this
         floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3b). -->
    <PackageReference Include="Octonica.ClickHouseClient" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol.Extensions.ClickHouse\Kronikol.Extensions.ClickHouse.csproj" />
  </ItemGroup>
</Project>
