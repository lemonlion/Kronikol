<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Google Cloud Storage Extension</Title>
    <Description>Google Cloud Storage tracking for test diagrams. Intercepts and classifies GCS operations (Upload, Download, Delete, List, Copy, Compose) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Google.Cloud.Storage.V1: 4.0.0 is the oldest 4.x the suite passes on, the first of the major, and its graph
         carries no known advisory (harness floor/r2a-cloudstorage.txt). FloorLedger holds the floor, and the test
         project's package fact reads it back from the packed nuspec; the suite runs on the newest 4.x, and on this
         floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R2a). -->
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
