<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <!-- A 1-5 s CLI process never reaches tier-1 JIT, so its loop-heavy methods (the report scan, the
         evaluate loops) would run their whole life unoptimized: measured at 25-30% of every command on a
         large report (QUERY_PERF_PLAN.md §1.1). Compile loop methods optimized on first call instead.
         Tool-only deliberately - the libraries live in long-lived test processes where default tiering
         is right. Guarded by Tool_runtimeconfig_pins_optimized_jit_for_loops. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <ToolCommandName>kronikol</ToolCommandName>
    <PackageId>Kronikol.Tool</PackageId>
    <Title>Kronikol CLI</Title>
    <Description>Command-line companion for Kronikol. Includes `kronikol merge`, which combines several mergeable TestRunReport.json files (produced with GenerateMergeableData enabled — e.g. by parallel CI runners) into a single combined TestRunReport.html; `kronikol ingest`, which replays language-neutral NDJSON interaction captures (from an out-of-process proxy tap or any non-.NET capturer) into a full Kronikol report; `kronikol query`, which answers questions about a TestRunReport.json — why a test failed, what a service returned, where a wrong value came from — without loading the file, so a 10 MB report is debuggable by tooling and by AI agents; and `kronikol export`, which pushes NDJSON interaction captures to an OTLP/HTTP collector as OpenTelemetry spans so the traffic only Kronikol saw appears in Tempo/Jaeger next to the app's real traces.</Description>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
    <ProjectReference Include="..\Kronikol.Extensions.Otlp\Kronikol.Extensions.Otlp.csproj" />
  </ItemGroup>

</Project>
