<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework />
	  <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
	  <Title>Test Tracking Diagrams For LightBDD TUnit</Title>
	  <Description>LightBDD + TUnit extensions for tracking service interactions (HTTP, database, cache, events, and more) in your tests and converting them into PlantUML sequence diagrams.</Description>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <IsPackable>true</IsPackable>
	  <IsTestProject>false</IsTestProject>
	  <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- LightBDD.TUnit: 3.12.1 is the oldest 3.x the suite passes on, and it asks for TUnit 1.53.0: 3.12.0 and older
         fail two of its facts, as 3.12.0 shipped hook registrations built against TUnit 1.0.0, which name
         TUnit.Core.Sources.AfterClassHooks, a field later TUnit.Core releases no longer have (MissingFieldException at
         module initialization); its graph carries no known advisory (harness floor/r3a-lightbdd-tunit.txt). FloorLedger
         holds the floor, and the test project's package fact reads it back from the packed nuspec; the suite runs on
         the newest 3.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R3a). -->
    <PackageReference Include="LightBDD.TUnit" Version="3.12.1">
      <PrivateAssets>build;buildTransitive;analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.2.3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>build;buildTransitive;buildMultitargeting</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol.LightBDD.Core\Kronikol.LightBDD.Core.csproj" />
    <ProjectReference Include="..\Kronikol.TUnit\Kronikol.TUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests" />
  </ItemGroup>

</Project>
