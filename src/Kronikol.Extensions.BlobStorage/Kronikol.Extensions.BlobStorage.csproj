<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Azure Blob Storage Extension</Title>
    <Description>Azure Blob Storage extensions for tracking blob operations in your tests and converting them into diagrams.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Storage.Blobs: 12.13.0 is the first release past GHSA-64x4-9hc6-r2h6 (moderate, a padding oracle in
         client-side encryption), as the suite passes from 12.0.0; its graph carries no other known advisory (harness
         floor/r2b-blobstorage.txt). FloorLedger holds the floor, and the test project's package fact reads it back from
         the packed nuspec; the suite runs on the newest 12.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R2b). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
