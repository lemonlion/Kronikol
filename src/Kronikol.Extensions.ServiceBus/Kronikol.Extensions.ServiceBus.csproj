<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Azure Service Bus Extension</Title>
    <Description>Azure Service Bus tracking for test diagrams. Intercepts and classifies Service Bus operations (Send, Receive, Complete, Abandon, DeadLetter, Defer, Schedule) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Messaging.ServiceBus: 7.11.0, as TrackingServiceBusReceiver overrides the DeadLetterMessageAsync with
         properties and a reason that 7.11.0 added, whose base would run against the empty receiver the wrapper is built
         as; the suite passes there, and from 7.10.0 without that override, and its graph carries no known advisory
         (harness floor/r2b-servicebus.txt). FloorLedger holds the floor, and the test project's package fact reads it
         back from the packed nuspec; the suite runs on the newest 7.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R2b). -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.11.0" />
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions: 10.0.7, the least the Kronikol core's graph allows, as
         Microsoft.AspNetCore.Mvc.Testing 10.0.7 asks for it through Microsoft.Extensions.Hosting and a lower pin is a
         downgrade NuGet refuses (NU1605); R3a measures that pin (harness floor/r2b-servicebus-di.txt)
         (plans/CLIENT_FLOORS_PLAN.md R2b). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
