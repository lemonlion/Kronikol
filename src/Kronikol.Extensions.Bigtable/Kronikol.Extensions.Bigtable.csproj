<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Google Cloud Bigtable Extension</Title>
    <Description>Google Cloud Bigtable tracking for test diagrams. Wraps BigtableClient to intercept and classify Bigtable operations (ReadRows, MutateRow, MutateRows, CheckAndMutateRow, ReadModifyWriteRow, SampleRowKeys) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kronikol.Tests.Bigtable" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Cloud.Bigtable.V2: 3.0.0 is the oldest 3.x the suite passes on, the first of the major, and its graph
         carries no known advisory; the extension calls none of the client's types (harness floor/r2a-bigtable.txt).
         FloorLedger holds the floor, and the test project's package fact reads it back from the packed nuspec; the
         suite runs on the newest 3.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R2a). -->
    <PackageReference Include="Google.Cloud.Bigtable.V2" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

</Project>
