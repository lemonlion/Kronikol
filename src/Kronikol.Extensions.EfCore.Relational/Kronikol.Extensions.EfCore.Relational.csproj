<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams EF Core Relational Extension</Title>
    <Description>EF Core relational database tracking for test diagrams. Intercepts and classifies SQL operations (Select, Insert, Update, Delete, Upsert, Merge, StoredProc) from any EF Core relational provider (SQL Server, PostgreSQL, MySQL, SQLite, Oracle, Spanner) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProviderReaderMethods and the update pipeline allow-list are pinned on their own -->
    <InternalsVisibleTo Include="Kronikol.Tests.EfCore.Relational" />
  </ItemGroup>

</Project>
