<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams EF Core Relational Extension</Title>
    <Description>EF Core relational database tracking for test diagrams. Intercepts and classifies SQL operations (Select, Insert, Update, Delete, Upsert, Merge, StoredProc) from any EF Core relational provider (SQL Server, PostgreSQL, MySQL, SQLite, Oracle, Spanner) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.EntityFrameworkCore.Relational: 10.0.0 is the first release of the major, and the suite passes on it
         with the providers of the same release; its graph carries no known advisory (plans/CLIENT_FLOORS_PLAN.md R2c)..
         FloorLedger holds the floor, and the test project's package fact reads it back from the packed nuspec; the
         suite runs on the newest 10.x, and on this floor with -p:FloorRun=true (plans/CLIENT_FLOORS_PLAN.md R2c). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProviderReaderMethods and the update pipeline allow-list are pinned on their own -->
    <InternalsVisibleTo Include="Kronikol.Tests.EfCore.Relational" />
  </ItemGroup>

</Project>
