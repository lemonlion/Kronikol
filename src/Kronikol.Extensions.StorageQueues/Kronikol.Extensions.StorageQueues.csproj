<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(MultiTargetFrameworks)</TargetFrameworks>
    <Title>Test Tracking Diagrams Azure Storage Queues Extension</Title>
    <Description>Azure Storage Queue tracking for test diagrams. Intercepts and classifies queue operations (Send, Receive, Peek, Delete, Update, Clear) with configurable verbosity.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Azure.Storage.Queues: 12.11.0 is the first release past GHSA-64x4-9hc6-r2h6 (moderate, a padding oracle in
         client-side encryption), as the suite passes from 12.0.0; its graph carries no other known advisory (harness
         floor/r2b-storagequeues.txt). FloorLedger holds the floor, and the test project's package fact reads it back
         from the packed nuspec; the suite runs on the newest 12.x, and on this floor with -p:FloorRun=true
         (plans/CLIENT_FLOORS_PLAN.md R2b). -->
    <PackageReference Include="Azure.Storage.Queues" Version="12.11.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kronikol\Kronikol.csproj" />
  </ItemGroup>
</Project>
